                                                <h4 style="margin-left: 0px; color:green; background-color: beige; font-weight:bold">Anexos</h4>
                                                <br />
                                                <div class="form-group">
                                                    @using (Html.BeginForm("UploadFileLeadBlob", "Administra", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { enctype = "multipart/form-data", @id = "pwd-container2" }))
                                                    {
                                                        var listaAnexos = Model.LEAD_ANEXO.Where(p => p.LEAX_IN_ATIVO == 1).ToList();

                                                        <div class="text-center" style="margin-top: 15px;">
                                                            <div class="toggle-container" id="viewToggle">
                                                                <div class="toggle-option active" data-target="sectionList">
                                                                    <i class="fa fa-list"></i> Ver lista
                                                                </div>
                                                                <div class="toggle-option" data-target="sectionIcons">
                                                                    <i class="fa fa-th"></i> Ver ícones
                                                                </div>
                                                            </div>
                                                        </div>

                                                        if (listaAnexos.Count > 0)
                                                        {
                                                            <div id="sectionList" class="view-section active">
                                                                <table class="table table-striped table-bordered table-hover dataTables-example">
                                                                    <thead style="background-color:lightsteelblue">
                                                                        <tr>
                                                                            <th>Título</th>
                                                                            <th>Data</th>
                                                                            <th>Tipo</th>
                                                                            <th class="td-one-action">Ações</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var cond in listaAnexos)
                                                                        {
                                                                            <tr>
                                                                                <td style="width: auto">
                                                                                    @if (cond.LEAX_IN_TIPO == 1 || cond.LEAX_IN_TIPO == 2)
                                                                                    {
                                                                                        <a href="@Url.Action("VerAnexoLead", "Administra", new { id = cond.LEAX_CD_ID })"  class="show-spinner" >@cond.LEAX_NM_TITULO</a>
                                                                                    }
                                                                                    else if (cond.LEAX_IN_TIPO == 4)
                                                                                    {
                                                                                        <a href="@Url.Action("VerAnexoLeadAudio", "Administra", new { id = cond.LEAX_CD_ID })" class="show-spinner">@cond.LEAX_NM_TITULO</a>
                                                                                    }
                                                                                    else if (cond.LEAX_IN_TIPO == 3)
                                                                                    {
                                                                                        // Monta a URL direta do Azure
                                                                                        var caminhoPdf = cond.LEAX_AQ_ARQUIVO.Replace("~/", "").Replace("~", "");
                                                                                        var urlAzurePdf = "https://rtistoragemain.blob.core.windows.net/rti-datacontainer/" + caminhoPdf;
                                                                                        <a href="@urlAzurePdf" target="_blank">@cond.LEAX_NM_TITULO</a>
                                                                                    }
                                                                                    else { @cond.LEAX_NM_TITULO }
                                                                                </td>
                                                                                <td>@cond.LEAX_DT_ANEXO.Value.ToShortDateString()</td>
