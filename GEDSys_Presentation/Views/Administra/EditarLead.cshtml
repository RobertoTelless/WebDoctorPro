                $('#txtMotivoExclusao').val('');
                $('#validaMotivoExclusao').hide();
                $('#btnConfirmarExclusaoSubmit').prop('disabled', false).removeClass('disabled').html('Confirmar Exclusão');
            });
        });
    </script>    
    @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                  alert("@ViewBag.Message");
            };
        </script>
    }
}

