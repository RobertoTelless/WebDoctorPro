@using Presentation.Extensions
@using EntitiesServices.Model
@model ERP_Condominios_Solution.ViewModels.LeadViewModel
@{
    Layout = "~/Views/Shared/_Layout_Adm.cshtml";
    ViewBag.Title = "WebDoctor - Laed - Edição";
    ViewBag.MetaDescription = "WebDoctor - Lead - Edição de Lead";
    ViewBag.MetaKeywords = "WebDoctor, Lead, Edicao";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="modal inmodal fade" id="modalConfirmacaoExclusaoAnexo" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content animated bounceInRight">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-trash-o modal-icon text-danger" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Exclusão de Anexo</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Anexos</small>
                </div>
            
                <div class="modal-body text-center">
                    <h3>Deseja realmente excluir este anexo?</h3>
                    <p>Esta ação removerá o arquivo permanentemente do lead.</p>
                    <input type="hidden" id="urlExclusaoTemp="" />
                </div>
            
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarExclusaoAnexo">Confirmar Exclusão</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal inmodal fade" id="modalConfirmacaoQuali" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-check-circle modal-icon text-primary" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Qualificação</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Leads</small>
                </div>
            
                <div class="modal-body text-center">
                    <h3>Tem certeza que deseja qualificar esse lead?</h3>
                    <p>Esta ação não poderá ser desfeita e os registros serão atualizados no sistema.</p>
                </div>
            
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Voltar</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmarQualiSubmit">Confirmar Qualificação</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal inmodal fade" id="modalStatusTransicao" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i id="iconModalTransicao" class="fa modal-icon" style="display: block;"></i>
                    <h4 class="modal-title" id="lblTituloModalTransicao">Alteração de Status</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Leads</small>
                </div>
    
                <div class="modal-body">
                    <div class="text-center">
                        <h3 id="lblSubTituloTransicao">Deseja alterar o status deste lead?</h3>
                        <p id="lblDescricaoTransicao">Esta ação atualizará o registro no banco de dados.</p>
                    </div>
                    <br />
                    <div class="form-group text-left">
                        <label class="font-bold" id="lblJustificativaTransicao">Justificativa / Observações *</label>
                        <textarea class="form-control" id="txtJustificativaTransicao" rows="3" maxlength="500" placeholder="Digite aqui os detalhes desta movimentação..."></textarea>
                        <span id="validaJustificativaTransicao" style="color:red; display:none;">A justificativa é obrigatória para esta alteração.</span>
                    </div>
                </div>
    
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Voltar</button>
                    <button type="button" class="btn" id="btnConfirmarTransicaoSubmit">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal inmodal fade" id="modalConfirmacaoExclusao" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-trash-o modal-icon text-danger" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Exclusão</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Leads</small>
                </div>
    
                <div class="modal-body">
                    <div class="text-center">
                        <h3>Confirma a exclusão deste Lead?</h3>
                        <p>Esta ação alterará o status do lead selecionado para inativo.</p>
                    </div>
                    <br />
                    <div class="form-group text-left">
                        <label class="font-bold">Motivo da Exclusão *</label>
                        <textarea class="form-control" id="txtMotivoExclusao" rows="3" maxlength="500" placeholder="Informe detalhadamente o motivo pelo qual este lead está sendo excluído..."></textarea>
                        <span id="validaMotivoExclusao" style="color:red; display:none;">O motivo da exclusão é obrigatório.</span>
                    </div>
                </div>
    
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarExclusaoSubmit">Confirmar Exclusão</button>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="targetStatusValue" value="" />
    <input type="hidden" id="urlExclusaoTemp" value="" />

    <div class="modalContainer">
        <div id="modal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        @*titulo gerado dinamicamente*@
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @*Gerado dinamicamente*@
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-title">
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaAdministra", "Administra")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("MontarTelaLead", "Administra")">Leads</a>
            </li>
            <li class="active">
                <strong>Leads - Alteração</strong>
            </li>
        </ol>
        <br />
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <div class="row">
                        <div style="text-align: center;" class="col-lg-12 col-md-12 col-xs-12">
                            <h5>Lead - Alteração</h5>
                            <span style="color:green; font-weight: 500; font-size: 20px;">@Model.LEAD_NM_NOME</span>
                        </div>
                    </div>
                </div>
                <div class="ibox-content">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <button type="button" class="close" data-dismiss="alert">Fechar</button>
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    }
                    <div class="form-group" style=" margin-left: 5px; margin-right: 5px;">
                        @if (Model.LEAD_IN_STATUS == 0)
                        {
                            @Html.ButtonLinkIndex(text: "Excluir Lead", action: "ExcluirLead", controller: "Administra", htmlAttributes: new { id = "btnExcluirLeadForm", @class = "btn btn-danger btn-trigger-exclusao" })
                        }
                        @Html.ButtonLinkIndex(text: "Enviar Mensagem", action: "EnviarMensagemLead", controller: "Administra", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        @Html.ButtonLinkIndex(text: "Voltar", action: "MontarTelaLead", controller: "Administra", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        <span id="loadingIndicator" style="display: none; margin-left: 10px; color: #007bff;">
                            <i class="fa fa-spinner fa-spin"></i> Processando...
                        </span>
                    </div>

                    <div class="tabs-container">
                        <ul class="nav nav-tabs">
                            @if ((Int32)Session["NivelLead"] == 1)
                            {
                                <li class="active"><a data-toggle="tab" href="#tab-1">Lead</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-3">Anotações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Processo</a></li>
                            }
                            @if ((Int32)Session["NivelLead"] == 2)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Lead</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-3">Anotações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Processo</a></li>
                            }
                            @if ((Int32)Session["NivelLead"] == 3)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Lead</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-3">Anotações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Processo</a></li>
                            }
                            @if ((Int32)Session["NivelLead"] == 4)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Lead</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-3">Anotações</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-4">Processo</a></li>
                            }
                        </ul>

                        <div class="tab-content">
                            @*Dados Gerais*@
                            @if ((Int32)Session["NivelLead"] == 1)
                            {
                                <div id="tab-1" class="tab-pane active">
                                    <div class="panel-body">
                                        @using (Html.BeginForm("EditarLead", "Administra", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", @id = "pwd-container1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="col-lg-8 col-md-8 col-xs-12">
                                                <div class="row" style="width: 100%;">
                                                    <h4 style="margin-left: -15px; color:green; background-color: beige; font-weight:bold">Criação</h4>
                                                    @if (Model.LEAD_IN_STATUS == 0 || Model.LEAD_IN_STATUS == 1)
                                                    {
                                                        <div class="form-group" style=" margin-left: -15px; margin-right: 5px;">
                                                            @Html.ButtonActionSubmit(text: "Confirma alteração de lead", htmlAttributes: new { id = "basictoast", @class = "btn-loading1 show-spinner" })
                                                        </div>
                                                    }
                                                    <div class="col-lg-12 col-md-12 col-xs-12">
                                                        <div class="form-group" style=" margin-left: -45px; margin-right: -15px;"> 
                                                            <div class="col-lg-2 col-md-2 col-xs-12">
                                                                Data de Criação
                                                                @Html.TextBoxFor(m => m.LEAD_DT_ENTRADA, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: green; font-weight: bold" })
                                                            </div>
                                                            <div class="col-lg-4 col-md-4 col-xs-12">
                                                                Identificador
                                                                @Html.TextBoxFor(m => m.LEAD_GU_IDENTIFICADOR, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: green; font-weight: bold" })
                                                            </div>
                                                            <div class="col-lg-2 col-md-2 col-xs-12">
                                                                Num.Mensagens
                                                                @Html.TextBoxFor(m => m.LEAD_IN_ENVIOS, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: green; font-weight: bold" })
                                                            </div>
                                                            <div class="col-lg-3 col-md-3 col-xs-12">
                                                                Status
                                                                @Html.TextBoxFor(m => m.Status, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: darkblue; font-weight: bold" })
                                                            </div>
                                                        </div>               
                                                    </div>
                                                </div>

                                                <div class="row" style="width: 100%;">
                                                    <h4 style="margin-left: -15px; color:green; background-color: beige; font-weight:bold">Situação</h4>
                                                    <div class="col-lg-12 col-md-12 col-xs-12">
                                                        @if (Model.LEAD_IN_STATUS == 0 || Model.LEAD_IN_STATUS == 1)
                                                        {
                                                            <div class="form-group" style=" margin-left: -45px; margin-right: -15px;"> 
                                                                @if (Model.LEAD_IN_STATUS == 0)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Status*
                                                                        @Html.DropDownListFor(m => m.LEAD_IN_STATUS, (SelectList)ViewBag.Status0, "Selecionar", new { @id = "ddlStatus", @class = "form-control", @style = "color: darkblue; font-weight: bold" })
                                                                        @Html.ValidationMessageFor(m => m.LEAD_IN_STATUS, "", new { @style = "color:red" })
                                                                    </div>
                                                                }
                                                                @if (Model.LEAD_IN_STATUS == 5)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Status*
                                                                        @Html.DropDownListFor(m => m.LEAD_IN_STATUS, (SelectList)ViewBag.Status2, "Selecionar", new { @id = "ddlStatusTest", @class = "form-control", @style = "color: darkblue; font-weight: bold" })
                                                                        @Html.ValidationMessageFor(m => m.LEAD_IN_STATUS, "", new { @style = "color:red" })
                                                                    </div>
                                                                }
                                                                @if (Model.LEAD_IN_STATUS == 1)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Status*
                                                                        @Html.DropDownListFor(m => m.LEAD_IN_STATUS, (SelectList)ViewBag.Status1, "Selecionar", new { @id = "ddlStatusTransicao", @class = "form-control", @style = "color: darkblue; font-weight: bold" })
                                                                        @Html.ValidationMessageFor(m => m.LEAD_IN_STATUS, "", new { @style = "color:red" })
                                                                    </div>
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Data da Qualificação
                                                                        @Html.TextBoxFor(m => m.LEAD_DT_MOVIMENTO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                }
                                                            </div>
                                                        }

                                                        @if (Model.LEAD_IN_STATUS == 4 || Model.LEAD_IN_STATUS == 3 || Model.LEAD_IN_STATUS == 2)
                                                        {
                                                            <div class="form-group" style=" margin-left: -45px; margin-right: -15px;">
                                                                @if (Model.LEAD_IN_STATUS == 4)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Data da Exclusão
                                                                        @Html.TextBoxFor(m => m.LEAD_DT_EXCLUSAO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                    <div class="col-lg-9 col-md-9 col-xs-12">
                                                                        Justificativa da Exclusão
                                                                        @Html.TextAreaFor(m => m.LEAD_DS_MOTIVO_EXCLUSAO, new { @class = "form-control", style = "width: 100%; height: 100px; overflow:auto;", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                }
                                                                @if (Model.LEAD_IN_STATUS == 3)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Data de Fechamento
                                                                        @Html.TextBoxFor(m => m.LEAD_DT_MOVIMENTO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                    <div class="col-lg-9 col-md-9 col-xs-12">
                                                                        Justificativa da Perda
                                                                        @Html.TextAreaFor(m => m.LEAD_DS_MOTIVO_EXCLUSAO, new { @class = "form-control", style = "width: 100%; height: 100px; overflow:auto;", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                }
                                                                @if (Model.LEAD_IN_STATUS == 2)
                                                                {
                                                                    <div class="col-lg-3 col-md-3 col-xs-12">
                                                                        Data de Conversão
                                                                        @Html.TextBoxFor(m => m.LEAD_DT_MOVIMENTO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                    <div class="col-lg-9 col-md-9 col-xs-12">
                                                                        Observações da Conversão
                                                                        @Html.TextAreaFor(m => m.LEAD_DS_MOTIVO_EXCLUSAO, new { @class = "form-control", style = "width: 100%; height: 100px; overflow:auto;", @tabindex = "-1", @readonly = "readonly" })
                                                                    </div>
                                                                }
                                                            </div>               
                                                        }
                                                    </div>
                                                </div>

                                                <div class="row" style="width: 100%;">
                                                    <h4 style="margin-left: -15px; color:green; background-color: beige; font-weight:bold">Identificação</h4>
                                                    <div class="form-group" style=" margin-left: -30px; margin-right: -15px;"> 
                                                        <div class="col-lg-6 col-md-6 col-xs-12">
                                                            @Html.HiddenFor(m => m.LEAD_IN_ATIVO)
                                                            @Html.HiddenFor(m => m.LEAD_IN_STATUS)
                                                            @Html.HiddenFor(m => m.LEAD_GU_IDENTIFICADOR)
                                                            @Html.HiddenFor(m => m.LEAD_DT_ENTRADA)
                                                            @Html.HiddenFor(m => m.LEAD_IN_SISTEMA)
                                                            @Html.HiddenFor(m => m.LEAD_IN_ENVIOS)
                                                            @Html.HiddenFor(m => m.USUA_CD_ID)
                                                            @Html.HiddenFor(m => m.LEAD_DT_EXCLUSAO)
                                                            @Html.HiddenFor(m => m.LEAD_DT_FECHAMENTO)
                                                            @Html.HiddenFor(m => m.LEAD_DT_MOVIMENTO)
                                                            @Html.HiddenFor(m => m.CRM1_CD_ID)
                                                            @Html.HiddenFor(m => m.LEAD_CD_ID)
                                                            @Html.HiddenFor(m => m.LEAD_IN_STATUS)
                                                            Nome*
                                                            @Html.TextBoxFor(m => m.LEAD_NM_NOME, new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe o nome completo associado ao lead", data_trigger="hover", data_placement="top", @style = "color: green; font-weight: bold"  })
                                                            @Html.ValidationMessageFor(m => m.LEAD_NM_NOME, "", new { @style = "color:red" })
                                                        </div>
                                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                                            CPF
                                                            @Html.TextBoxFor(m => m.LEAD_NR_CPF, new { @class = "form-control", autofocus = true, @id = "cpf" , data_toggle = "popover", data_content = "Informe o CPF associado ao lead", data_trigger="hover", data_placement="top" })
                                                            @Html.ValidationMessageFor(m => m.LEAD_NR_CPF, "", new { @style = "color:red" })
                                                        </div>
                                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                                            CNPJ
                                                            @Html.TextBoxFor(m => m.LEAD_NR_CNPJ, new { @class = "form-control", autofocus = true, @id = "cnpj" , data_toggle = "popover", data_content = "Informe o CNPJ associado ao lead", data_trigger="hover", data_placement="top" })
                                                            @Html.ValidationMessageFor(m => m.LEAD_NR_CNPJ, "", new { @style = "color:red" })
                                                        </div>
                                                    </div>               
                                                </div>                                    
                                                <div class="row" style="width: 100%;">
                                                    <h4 style="margin-left: -15px; color:green; background-color: beige; font-weight:bold">Informações de Contato</h4>
                                                    <div class="form-group" style=" margin-left: -30px; margin-right: -15px;">                
                                                        <div class="col-lg-5 col-md-5 col-xs-12">
                                                            E-Mail*
                                                            @Html.TextBoxFor(m => m.LEAD_EM_EMAIL, new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe o e-mail associado ao lead", data_trigger="hover", data_placement="top" })
                                                            @Html.ValidationMessageFor(m => m.LEAD_EM_EMAIL, "", new { @style = "color:red" })
                                                        </div>
                                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                                            Celular
                                                            @Html.TextBoxFor(m => m.LEAD_NR_CELULAR, new { @class = "form-control", autofocus = true, @id= "cel", data_toggle = "popover", data_content = "Informe o celular associado ao lead", data_trigger="hover", data_placement="top" })
                                                            @Html.ValidationMessageFor(m => m.LEAD_NR_CELULAR, "", new { @style = "color:red" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style=" margin-left: -30px; margin-right: -15px;">
                                                        <div class="col-lg-12 col-md-12 col-xs-12">
                                                            Descrição (O WebDoctor preenche automaticamente esse campo)
                                                            @Html.TextAreaFor(m => m.LEAD_DS_DESCRICAO, new { @class = "form-control", style = "width: 100%; height: 100px; overflow:auto;", autofocus = true, @id="desc", data_toggle = "popover", data_content = "Informe um texto que será acrescentado à descrição gerada automaticamente", data_trigger="hover", data_placement="top" })
                                                            @Html.ValidationMessageFor(m => m.LEAD_DS_DESCRICAO, "", new { @style = "color:red" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" style="width: 100%;">
                                                    <h4 style="margin-left: -15px; color:green; background-color: beige; font-weight:bold">Endereço</h4>
                                                    <div class="form-group" style=" margin-left: -30px; margin-right: -15px;">
                                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                                            CEP
                                                            <div class="input-group">
                                                                @Html.TextBoxFor(m => m.LEAD_NR_CEP, new { @class = "form-control", @id = "cep", autofocus = true, @onblur = "PesquisaCep($('#cep').val(), $(this), 1)" })
                                                                @Html.ValidationMessageFor(m => m.LEAD_NR_CEP, "", new { @style = "color:red" })
                                                                <span class="input-group-btn">
