                                                    @Html.HiddenFor(m => m.FUNI_IN_FIXO)
                                                    @Html.HiddenFor(m => m.FUNI_IN_TIPO)
                                                    @Html.HiddenFor(m => m.FUNI_IN_CLIENTE)
