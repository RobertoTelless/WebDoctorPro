@using Presentation.Extensions
@model ERP_Condominios_Solution.ViewModels.FunilViewModel
@{
    Layout = "~/Views/Shared/_Layout_Adm.cshtml";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="modal inmodal fade" id="modalConfirmacaoExclusao" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-trash-o modal-icon text-danger" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Exclusão</h4>
                    <small class="font-bold">WebDoctorPro - Etapas de Funis de Processo</small>
                </div>
    
                <div class="modal-body">
                    <div class="text-center">
                        <h3>Confirma a exclusão desta Etapa?</h3>
                        <p>Nenhum etapa de um funil em uso por algum processo CRM poderá ser excluido.</p>
                    </div>
                    <br />
                    <!-- NOVO CAMPO: Motivo da Exclusão -->
                    <div class="form-group text-left">
                        <label class="font-bold">Motivo da Exclusão *</label>
                        <textarea class="form-control" id="txtMotivoExclusao" rows="3" maxlength="500" placeholder="Informe detalhadamente o motivo pelo qual este funil está sendo excluído..."></textarea>
                        <span id="validaMotivoExclusao" style="color:red; display:none;">O motivo da exclusão é obrigatório.</span>
                    </div>
                </div>
    
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarExclusaoSubmit">Confirmar Exclusão</button>
                </div>
            </div>
        </div>
    </div>
    <div class="page-title">
        <h3 class="title">Funis de Processos</h3>
        <br />
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaAdministra", "Administra")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("MontarTelaFunil", "Funil")">Funis de Processos</a>
            </li>
            <li class="active">
                <strong>Funis de Processos - Alteração</strong>
            </li>
        </ol>
        <br />
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Funis de Processos - Alteração</h5>
                </div>
                <div class="ibox-content">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <button type="button" class="close" data-dismiss="alert">Fechar</button>
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    }
                    <div class="form-group">
                        @Html.ButtonLinkIndex(text: "Voltar", action: "VoltarBaseFunil", controller: "Funil", htmlAttributes: new { @class = "show-spinner" })
                    </div>
                    <div class="tabs-container">
                        <ul class="nav nav-tabs">
                            @if ((Int32)Session["TabFunil"] == 1)
                            {
                                <li class="active"><a data-toggle="tab" href="#tab-1">Dados Gerais</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Etapas</a></li>
                            }
                            @if ((Int32)Session["TabFunil"] == 2)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Dados Gerais</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-4">Etapas</a></li>
                            }
                        </ul>
                        <div class="tab-content">
                            @*Dados Gerais*@
                            @if ((Int32)Session["TabFunil"] == 1)
