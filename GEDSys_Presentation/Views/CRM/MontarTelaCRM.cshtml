@using Presentation.Extensions
@using CrossCutting;
@using EntitiesServices.Work_Classes;
@model EntitiesServices.Model.CRM
@{
    Layout = "~/Views/Shared/_Layout_Adm.cshtml";
    ViewBag.Title = "WebDoctor - Lead - Inclusão";
    ViewBag.MetaDescription = "WebDoctor - Lead - Inclusão de Lead";
    ViewBag.MetaKeywords = "WebDoctor, Lead";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div id="top"></div>
    <div class="modal inmodal fade" id="modalConfirmacaoExclusao" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-trash-o modal-icon text-danger" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Exclusão</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Processos</small>
                </div>
    
                <div class="modal-body">
                    <div class="text-center">
                        <h3>Confirma a exclusão deste Processo?</h3>
                        <p>Esta ação alterará o status do processo selecionado para inativo.</p>
                    </div>
                    <br />
                    <!-- NOVO CAMPO: Motivo da Exclusão -->
                    <div class="form-group text-left">
                        <label class="font-bold">Motivo da Exclusão *</label>
                        <textarea class="form-control" id="txtMotivoExclusao" rows="3" maxlength="500" placeholder="Informe detalhadamente o motivo pelo qual este processo está sendo excluído..."></textarea>
                        <span id="validaMotivoExclusao" style="color:red; display:none;">O motivo da exclusão é obrigatório.</span>
                    </div>
                </div>
    
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarExclusaoSubmit">Confirmar Exclusão</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal inmodal fade" id="modalConfirmacaoCancela" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="position: relative; padding: 30px 15px;">
                    <img src="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" 
                         style="position: absolute; left: 15px; top: 15px; width: 40px; height: auto;" 
                         alt="Ícone" />

                    <i class="fa fa-trash-o modal-icon text-danger" style="display: block;"></i>
                    <h4 class="modal-title">Confirmação de Cancelamento</h4>
                    <small class="font-bold">WebDoctorPro - Gestão de Processos</small>
                </div>
    
                <div class="modal-body">
                    <div class="text-center">
                        <h3>Confirma o cancelamento deste Processo?</h3>
                        <p>Esta ação alterará o status do processo selecionado para cancelado.</p>
                    </div>
                    <br />
                    <!-- NOVO CAMPO: Motivo da Exclusão -->
                    <div class="form-group text-left">
                        <label class="font-bold">Motivo do Cancelamento*</label>
                        <textarea class="form-control" id="txtMotivoCancela" rows="3" maxlength="500" placeholder="Informe detalhadamente o motivo pelo qual este processo está sendo cancelado..."></textarea>
                        <span id="validaMotivoCancela" style="color:red; display:none;">O motivo do cancelamento é obrigatório.</span>
                    </div>
                </div>
    
                <div class="modal-footer">
                    <button type="button" class="btn btn-white" data-dismiss="modal">Voltar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmarCancelaSubmit">Confirmar Cancelamento</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modalContainer">
        <div id="modal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        @*titulo gerado dinamicamente*@
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @*Gerado dinamicamente*@
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="containerModalDesc">
        <div class="modal fade" id="modalDesc" tabindex="-1" role="dialog" aria-labelledby="modalDesc" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalDesc">Descrição do Processo</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div id="modalDescBody" class="modal-body">

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-title">
        <h3 class="title">Processos</h3>
        <br />
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaAdministra", "Administra")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Processos CRM</strong>
            </li>
        </ol>
        <br />
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Filtros</h5>
                </div>

                @using (Html.BeginForm("FiltrarCRM", "CRM", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    <div class="ibox-content">
                        <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Funil
                                @Html.DropDownListFor(m => m.FUNI_CD_ID, (SelectList)ViewBag.Funis, "Selecionar", new { @class = "form-control", autofocus = true })
                            </div>
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Data de Criação (Início)
                                @Html.TextBoxFor(m => m.CRM1_DT_CRIACAO, "{0:dd/MM/yyyy}", new { @class = "form-control date-picker", autofocus = true, @id="data1", data_toggle = "popover", data_content = "Informe a data inicial da faixa de datas a ser pesquisada", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Data de Criação (Final)
                                @Html.TextBoxFor(m => m.CRM1_DT_CANCELAMENTO, "{0:dd/MM/yyyy}", new { @class = "form-control date-picker", autofocus = true, @id="data2", data_toggle = "popover", data_content = "Informe a data final da faixa de datas a ser pesquisada", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Origem
                                @Html.DropDownListFor(m => m.ORIG_CD_ID, (SelectList)ViewBag.Origem, "Selecionar", new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe a origem do processo a ser pesquisada", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Situação
                                @Html.DropDownListFor(m => m.CRM1_IN_ATIVO, (SelectList)ViewBag.Adic, "Selecionar", new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe a situação do processo a ser pesquisada", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Favorito
                                @Html.DropDownListFor(m => m.CRM1_IN_ESTRELA, (SelectList)ViewBag.Favorito, "Selecionar", new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe se pesquisa apenas favoritos", data_trigger="hover", data_placement="top" })
                            </div>
                        </div>
                        <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                            <div class="col-lg-2 col-md-2 col-xs-12">
                                Temperatura
                                @Html.DropDownListFor(m => m.CRM1_NR_TEMPERATURA, (SelectList)ViewBag.Temp, "Selecionar", new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe a temperatura a ser pesquisada", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-4 col-md-4 col-xs-12">
                                Nome do Processo
                                @Html.TextBoxFor(m => m.CRM1_NM_NOME, new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe o nome do processo (ou fragmento) a ser pesquisado", data_trigger="hover", data_placement="top" })
                            </div>
                            <div class="col-lg-6 col-md-6 col-xs-12">
                                Nome do Lead (Nome ou Fragmento)
                                @Html.TextBoxFor(m => m.CRM1_DS_DESCRICAO, new { @class = "form-control", autofocus = true, data_toggle = "popover", data_content = "Informe o nome do lead que originou o processo a ser pesquisado", data_trigger="hover", data_placement="top" })
                            </div>
                        </div>
                        <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                            <div class="col-lg-12 col-md-12 col-xs-12">                                     
                                @Html.ButtonActionSubmit(text: "Filtrar", htmlAttributes: new { @class = "show-spinner" })
                                @Html.ButtonLinkIndex(text: "Novo Processo", controller: "CRM", action: "IncluirProcessoCRM", buttonClass: "primary", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Retirar Filtro", controller: "CRM", action: "RetirarFiltroCRM", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Visualização Kanban", controller: "CRM", action: "MontarTelaCRMKanbaChama", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Ações do Usuário", controller: "CRM", action: "VerAcoesUsuarioCRMPrevia1", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Histórico", controller: "CRM", action: "MontarTelaHistoricoGeral", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Gerar Listagem", controller: "CRM", action: "GerarRelatorioListaCRM")
                                @Html.ButtonLinkIndex(text: "Mensagens Enviadas", action: "VerMensagensEnviadas", controller: "CRM", buttonClass: "success", htmlAttributes: new { @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Dashboard Gerencial", action: "MontarTelaDashboardGerencial", controller: "BaseAdmin", buttonClass: "success", htmlAttributes: new { @id = "cr", OnClick = "Fade()", @class = "btn-loading show-spinner" })
                                @Html.ButtonLinkIndex(text: "Voltar", action: "MontarTelaAdministra", controller: "Administra", htmlAttributes: new { @class = "btn-loading show-spinner" })                
                                <span id="loadingIndicator" style="display: none; margin-left: 10px; color: #007bff;">
                                    <i class="fa fa-spinner fa-spin"></i> Processando...
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12"  id="Lista">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Processos</h5>
                </div>
                <div class="ibox-content">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <button type="button" class="close" data-dismiss="alert">Fechar</button>
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    }
                    <div class="row">
                        @if (ViewBag.Listas != null && (ViewBag.Listas as List<EntitiesServices.Model.CRM>).Count > 0)
                        {
                            <table class="table table-striped table-bordered table-hover dataTables-example">
                                <thead style="background-color:lightsteelblue">
                                    <tr>
                                        <th class="td-one-action"></th>
                                        <th style="width: auto">Data de Criação</th>
                                        <th style="width: auto">Processo</th>
                                        <th style="width: auto">Funil</th>
                                        <th style="width: auto">Etapa</th>
                                        <th style="width: auto">Lead</th>
                                        <th style="width: auto">Próxima Ação</th>
                                        <th style="width: auto">Data Prevista</th>
                                        <th style="width: auto">Origem</th>
                                        <th style="width: auto">Situação</th>
                                        <th class="td-one-action">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cond in (ViewBag.Listas as List<EntitiesServices.Model.CRM>).OrderByDescending(p => p.CRM1_DT_CRIACAO))
                                    {
                                        if (cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).ToList().Count == 0)
                                        {
                                            if (cond.CRM1_IN_ATIVO != 2)
                                            {
                                                if (cond.CRM1_CD_ID != (Int32)Session["LinhaAlterada"])
                                                {
                                                    <tr>     
                                                        <td class="td-one-action">
                                                            @if (cond.CRM1_IN_ATIVO != 3)
                                                            {
                                                                if (cond.CRM1_IN_ESTRELA == 1)
                                                                {
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Desativar" class="tbl-link fa-lg fa fa-star show-spinner" onclick="ShowModalEstrelaNao('/CRM/EstrelaNao/@cond.CRM1_CD_ID')" title="Arquivar"></span>
                                                                }
                                                                else if (cond.CRM1_IN_ESTRELA == 0)
                                                                {   
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Reativar" class="tbl-link fa-lg fa fa-star-o show-spinner" onclick="ShowModalEstrelaSim('/CRM/EstrelaSim/@cond.CRM1_CD_ID')" title="Reativar"></span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (cond.CRM1_IN_ESTRELA == 1)
                                                                {
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Desativar" class="tbl-link fa-lg fa fa-star" title="Arquivar"></span>
                                                                }
                                                                else if (cond.CRM1_IN_ESTRELA == 0)
                                                                {   
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Reativar" class="tbl-link fa-lg fa fa-star-o" title="Reativar"></span>
                                                                }
                                                            }
                                                        </td>

                                                        <td>
                                                            <span style="display:none; width: auto">@cond.CRM1_DT_CRIACAO.Value.ToString("yyyyMMdd")</span>
                                                            @cond.CRM1_DT_CRIACAO.Value.ToString("dd/MM/yyyy")
                                                        </td>

                                                        @if (cond.CRM1_IN_ATIVO == 3 || cond.CRM1_IN_ATIVO == 4 || cond.CRM1_IN_ATIVO == 8)
                                                        {
                                                            <td><a href="@Url.Action("VisualizarProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                        }
                                                        else if (cond.CRM1_IN_ATIVO == 2)
                                                        {
                                                            <td><a href="@Url.Action("VisualizarProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                        }                                             
                                                        else
                                                        {
                                                            if (cond.CRM1_DT_ENCERRAMENTO == null)
                                                            {
                                                                <td><a href="@Url.Action("AcompanhamentoProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                            }
                                                            else
                                                            {
                                                                <td><a href="@Url.Action("VisualizarProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                            }
                                                        }

                                                        <td>@cond.FUNIL.FUNI_NM_NOME</td>

                                                        <td style="width: auto; color: green; font-weight:bold">@cond.FUNIL.FUNIL_ETAPA.Where(p => p.FUET_CD_ID == cond.CRM1_IN_STATUS).First().FUET_NM_NOME</td>

                                                        <td><a href="@Url.Action("EditarLeadForm", "CRM", new { id = cond.LEAD_CD_ID })" class="show-spinner" />@cond.LEAD.LEAD_NM_NOME</td>

                                                        @if (cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).ToList().Count > 0)
                                                        {
                                                            <td style="width: auto">@cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).OrderByDescending(m => m.CRAC_DT_PREVISTA).FirstOrDefault().CRAC_NM_TITULO</td>
                                                            if (cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).OrderByDescending(m => m.CRAC_DT_PREVISTA).FirstOrDefault().CRAC_DT_PREVISTA.Value.Date >= DateTime.Today.Date)
                                                            {
                                                                <td style="width: auto; color: green; font-weight:bold">@cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).OrderByDescending(m => m.CRAC_DT_PREVISTA).FirstOrDefault().CRAC_DT_PREVISTA.Value.ToShortDateString()</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="width: auto; color: red; font-weight:bold">@cond.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).OrderByDescending(m => m.CRAC_DT_PREVISTA).FirstOrDefault().CRAC_DT_PREVISTA.Value.ToShortDateString()</td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td>-</td>
                                                            <td>-</td>
                                                        }

                                                        @if (Model.CRM_ORIGEM != null)
                                                        {
                                                            <td>@cond.CRM_ORIGEM.CROR_NM_NOME</td>
                                                        }
                                                        else
                                                        {
                                                            <td>-</td>
                                                        }

                                                        <td style="width: auto">
                                                            @if (cond.CRM1_IN_ATIVO == 1)
	                                                        {
                                                            <span class="status-badge status-active">Ativo</span>
                                                            }
                                                            else if (cond.CRM1_IN_ATIVO == 2)
                                                            {
                                                                <span class="status-badge status-cancel">Arquivado</span>
                                                            }
                                                            else if (cond.CRM1_IN_ATIVO == 3)
                                                            {
                                                                <span class="status-badge status-cancel">Cancelado</span>
                                                            }   
                                                            else if (cond.CRM1_IN_ATIVO == 4)
                                                            {
                                                                <span class="status-badge status-pending">Falhado</span>
                                                            }
                                                            else if (cond.CRM1_IN_ATIVO == 5)
                                                            {
                                                                <span class="status-badge status-finish">Sucesso</span>
                                                            }
                                                        </td>
                                                        <td class="td-one-action">
                                                            @Html.TableLinkDetails(cond.CRM1_CD_ID, "VerHistoricoCRM", "fa-calendar show-spinner", "Histórico")
                                                            @if (cond.CRM1_IN_ATIVO == 3 || cond.CRM1_IN_ATIVO == 4 || cond.CRM1_IN_ATIVO == 8)
                                                            {
                                                                @Html.TableLinkDetails(cond.CRM1_CD_ID, "VisualizarProcessoCRM", "fa-search show-spinner", "Consultar")
                                                            }
                                                            else if (cond.CRM1_IN_ATIVO == 2)
                                                            {
                                                                @Html.TableLinkDetails(cond.CRM1_CD_ID, "VisualizarProcessoCRM", "fa-search show-spinner", "Consultar")
                                                            }                                             
                                                            else
                                                            {
                                                                if (cond.CRM1_DT_ENCERRAMENTO == null)
                                                                {
                                                                    @Html.TableLinkDetails(cond.CRM1_CD_ID, "AcompanhamentoProcessoCRM", "fa-cubes show-spinner", "Acompanhar")

                                                                    @Html.TableLinkDetails(cond.CRM1_CD_ID, "CancelarProcessoCRM", "fa-times show-spinner", "Cancelar")
                                                                }
                                                                else
                                                                {
                                                                    @Html.TableLinkDetails(cond.CRM1_CD_ID, "VisualizarProcessoCRM", "fa-search show-spinner", "Consultar")
                                                                }

                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr style="background-color: lavender" >
                                                        <td class="td-one-action">
                                                            @if (cond.CRM1_IN_ATIVO != 3)
                                                            {
                                                                if (cond.CRM1_IN_ESTRELA == 1)
                                                                {
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Desativar" class="tbl-link fa-lg fa fa-star show-spinner" onclick="ShowModalEstrelaNao('/CRM/EstrelaNao/@cond.CRM1_CD_ID')" title="Arquivar"></span>
                                                                }
                                                                else if (cond.CRM1_IN_ESTRELA == 0)
                                                                {   
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Reativar" class="tbl-link fa-lg fa fa-star-o show-spinner" onclick="ShowModalEstrelaSim('/CRM/EstrelaSim/@cond.CRM1_CD_ID')" title="Reativar"></span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (cond.CRM1_IN_ESTRELA == 1)
                                                                {
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Desativar" class="tbl-link fa-lg fa fa-star" title="Arquivar"></span>
                                                                }
                                                                else if (cond.CRM1_IN_ESTRELA == 0)
                                                                {   
                                                                    <span style="color: #337ab7; cursor:pointer;" alt="Reativar" class="tbl-link fa-lg fa fa-star-o" title="Reativar"></span>
                                                                }
                                                            }
                                                        </td>

                                                        <td>
                                                            <span style="display:none; width: auto">@cond.CRM1_DT_CRIACAO.Value.ToString("yyyyMMdd")</span>
                                                            @cond.CRM1_DT_CRIACAO.Value.ToString("dd/MM/yyyy")
                                                        </td>

                                                        @if (cond.CRM1_IN_ATIVO == 3 || cond.CRM1_IN_ATIVO == 4 || cond.CRM1_IN_ATIVO == 8)
                                                        {
                                                            <td><a href="@Url.Action("VisualizarProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                        }
                                                        else if (cond.CRM1_IN_ATIVO == 2)
                                                        {
                                                            <td><a href="@Url.Action("VisualizarProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                        }                                             
                                                        else
                                                        {
                                                            if (cond.CRM1_DT_ENCERRAMENTO == null)
                                                            {
                                                                <td><a href="@Url.Action("AcompanhamentoProcessoCRM", "CRM", new { id = cond.CRM1_CD_ID })" class="show-spinner" />@cond.CRM1_NM_NOME</td>
                                                            }
