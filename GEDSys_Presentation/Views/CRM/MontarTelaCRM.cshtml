                .css("display", "normal")
                .next("button").button({
                    icons: { primary: "ui-icon-calendar" },
                    label: "Selecione uma data",
                    text: false
                });
        }
    </script>

    <script type="text/javascript">
        var locacaoIdParaExcluir = null;

        function ChamarModalExcluir(id) {
            locacaoIdParaExcluir = id;
            // Reseta o campo de texto e o aviso ao abrir a modal
            $('#txtMotivoExclusao').val('');
            $('#validaMotivoExclusao').hide();
            $('#modalConfirmacaoExclusao').modal('show');
        }

        $(document).ready(function () {
            $('#btnConfirmarExclusaoSubmit').click(function () {
                if (locacaoIdParaExcluir != null) {
                    var motivoTxt = $('#txtMotivoExclusao').val().trim();

                    // Validação de campo obrigatório
                    if (motivoTxt === "") {
                        $('#validaMotivoExclusao').show();
                        $('#txtMotivoExclusao').focus();
                        return false;
                    }

                    var $btn = $(this);
            
                    // Feedback visual de carregamento
                    $btn.prop('disabled', true).addClass('disabled');
                    $btn.html('<i class="fa fa-spinner fa-spin"></i> Excluindo...');
                    $('#loadingIndicator').show();

                    // Criamos um formulário temporário em memória para enviar via POST seguro
                    var form = document.createElement("form");
                    form.method = "POST";
                    form.action = '/CRM/ExcluirProcesso';

                    // Input do ID
                    var inputId = document.createElement("input");
                    inputId.type = "hidden";
                    inputId.name = "id";
                    inputId.value = locacaoIdParaExcluir;
                    form.appendChild(inputId);

                    // Input do Motivo (Varchar 500)
                    var inputMotivo = document.createElement("input");
                    inputMotivo.type = "hidden";
                    inputMotivo.name = "motivo";
                    inputMotivo.value = motivoTxt;
                    form.appendChild(inputMotivo);

                    document.body.appendChild(form);
                    form.submit();
                }
            });

            // Limpeza de segurança ao fechar a modal
            $('#modalConfirmacaoExclusao').on('hidden.bs.modal', function () {
                locacaoIdParaExcluir = null;
                $('#txtMotivoExclusao').val('');
                $('#validaMotivoExclusao').hide();
            });
        });
    </script>

