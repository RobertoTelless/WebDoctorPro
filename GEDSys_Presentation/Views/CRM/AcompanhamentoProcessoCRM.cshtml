@using Presentation.Extensions
@using EntitiesServices.Work_Classes;
@using Humanizer; 
@model ERP_Condominios_Solution.ViewModels.CRMViewModel
@{
    Layout = "~/Views/Shared/_Layout_Adm.cshtml";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="modalContainer">
        <div id="modal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        @*titulo gerado dinamicamente*@
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @*Gerado dinamicamente*@
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modalContainer">
        <div id="modalProp" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        @*titulo gerado dinamicamente*@
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @*Gerado dinamicamente*@
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="containerModalDesc">
        <div class="modal fade" id="modalDesc" tabindex="-1" role="dialog" aria-labelledby="modalDesc" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalDesc">Mensagem Enviada</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div id="modalDescBody" class="modal-body">

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    @using (Html.BeginForm("EnviarSmsContato", "CRM", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal" }))
    { 
            <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Enviar SMS</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                      @Html.Hidden("id", null, new { id = "idClie" })
                      Mensagem
                      @Html.TextBox("mensagem", null, new { @style = "height: 200px;", @class = "form-control" })
                  </div>
                  <div class="modal-footer">
                      @Html.ButtonActionSubmit("Enviar")
                    <button type="button" class="btn btn-sm btn-warning" data-dismiss="modal">Cancelar</button>
                  </div>
                </div>
              </div>
            </div>
    }

    <div class="page-title">
        <h3 class="title">Processos</h3>
        <br />
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaAdministra", "Administra")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("MontarTelaCRM", "CRM")">Processos</a>
            </li>
            <li class="active">
                <strong>Processos - Acompanhamento</strong>
            </li>
        </ol>
        <br />
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Processos - Acompanhamento</h5>
                </div>
                <div class="ibox-content">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <button type="button" class="close" data-dismiss="alert">Fechar</button>
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    }
                    <div class="form-group">
                        @if (ViewBag.Ant == 2 & Model.CRM1_DT_ENCERRAMENTO == null)
                        {
                            @Html.ButtonLinkIndex(text: "Voltar para Etapa Anterior", action: "ConfirmarEtapaAnterior", controller: "CRM", buttonClass: "primary", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        }
                        @if (ViewBag.Prox == 2)
                        {
                            @Html.ButtonLinkIndex(text: "Ir para Próxima Etapa", action: "ConfirmarEtapaProxima", controller: "CRM", buttonClass: "primary", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        }
                        @if (((EntitiesServices.Model.PERFIL)Session["PerfilUsuario"]).PERF_IN_ENCERRA_CRM == 1)
                        {
                            if (ViewBag.Encerra == 1)
                            {
                                @Html.ButtonLinkIndex(text: "Encerrar Processo", action: "EncerrarProcessoChamada", controller: "CRM", buttonClass: "success", htmlAttributes: new { @class = "btn-loading show-spinner" })
                            }
                        }
                        @Html.ButtonLinkIndex(text: "Histórico Diário do Processo", action: "MontarTelaHistorico", controller: "CRM", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        @Html.ButtonLinkIndex(text: "Voltar", action: "MontarTelaCRM", controller: "CRM", htmlAttributes: new { @class = "btn-loading show-spinner" })
                        <span id="loadingIndicator" style="display: none; margin-left: 10px; color: #007bff;">
                            <i class="fa fa-spinner fa-spin"></i> Processando...
                        </span>
                    </div>

                    <h4 style="color: green; font-weight: bold; background-color:antiquewhite">Identificador: @Model.CRM1_ID_IDENTIFICADOR</h4><br />
                    <div class="tabs-container">
                        <ul class="nav nav-tabs">
                            @if ((Int32)Session["NivelCRM"] == 1)
                            {
                                <li class="active"><a data-toggle="tab" href="#tab-1">Informações do Processo</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-5">Ações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Anotações & Acompanhamento</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                            }
                            @if ((Int32)Session["NivelCRM"] == 2)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Informações do Processo</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-5">Ações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Anotações & Acompanhamento</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                            }
                            @if ((Int32)Session["NivelCRM"] == 3)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Informações do Processo</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-5">Ações</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-4">Anotações & Acompanhamento</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                            }
                            @if ((Int32)Session["NivelCRM"] == 4)
                            {
                                <li class=""><a data-toggle="tab" href="#tab-1">Informações do Processo</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-5">Ações</a></li>
                                <li class=""><a data-toggle="tab" href="#tab-4">Anotações & Acompanhamento</a></li>
                                <li class="active"><a data-toggle="tab" href="#tab-2">Anexos</a></li>
                            }
                        </ul>
                        <div class="tab-content">
                            @*Dados Gerais*@
                            @if ((Int32)Session["NivelCRM"] == 1)
                            {
                                <div id="tab-1" class="tab-pane active">
                                    <div class="panel-body">
                                        @using (Html.BeginForm("AcompanhamentoProcessoCRM", "CRM", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", @id = "pwd-container1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="row">
                                                @Html.HiddenFor(m => m.ASSI_CD_ID)
                                                @Html.HiddenFor(m => m.CLIE_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_AQ_IMAGEM)
                                                @Html.HiddenFor(m => m.CRM1_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_DS_INFORMACOES_ENCERRAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DS_MOTIVO_CANCELAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DT_CANCELAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DT_CRIACAO)
                                                @Html.HiddenFor(m => m.CRM1_DT_DATA_SAIDA)
                                                @Html.HiddenFor(m => m.CRM1_DT_ENCERRAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DT_PREVISAO_ENTREGA)
                                                @Html.HiddenFor(m => m.CRM1_IN_ATIVO)
                                                @Html.HiddenFor(m => m.CRM1_IN_AVISO_ENTREGA)
                                                @Html.HiddenFor(m => m.CRM1_IN_DUMMY)
                                                @Html.HiddenFor(m => m.CRM1_IN_ENTREGA_CONFIRMADA)
                                                @Html.HiddenFor(m => m.CRM1_IN_ESTRELA)
                                                @Html.HiddenFor(m => m.CRM1_IN_STATUS)
                                                @Html.HiddenFor(m => m.CRM1_NM_NOME)
                                                @Html.HiddenFor(m => m.CRM1_NR_ATRASO)
                                                @Html.HiddenFor(m => m.CRM_DS_INFORMACOES_SAIDA)
                                                @Html.HiddenFor(m => m.MENS_CD_ID)
                                                @Html.HiddenFor(m => m.MOCA_CD_ID)
                                                @Html.HiddenFor(m => m.MOEN_CD_ID)
                                                @Html.HiddenFor(m => m.TICR_CD_ID)
                                                @Html.HiddenFor(m => m.ORIG_CD_ID)
                                                @Html.HiddenFor(m => m.TRAN_CD_ID)
                                                @Html.HiddenFor(m => m.USUA_CD_ID)
                                                @Html.HiddenFor(m => m.FUNI_CD_ID)
                                                @Html.HiddenFor(m => m.EMPR_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_IN_ENCERRADO)
                                                @Html.HiddenFor(m => m.USUA_CD_ID)
                                                @Html.HiddenFor(m => m.EMFI_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_ID_IDENTIFICADOR)
                                                @Html.HiddenFor(m => m.CRM1_IN_SISTEMA)
                                                @Html.HiddenFor(m => m.LEAD_CD_ID)
                                                @Html.HiddenFor(m => m.PACI_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_DT_EXCLUSAO)
                                                @Html.HiddenFor(m => m.CRM1_TX_RESUMO)

                                                <div class="col-lg-4">
                                                    <div class="ibox float-e-margins" style="border-bottom: solid; border-bottom-color: darkblue; border-bottom-width: 1px; border-left: solid; border-left-color: darkblue; border-left-width: 1px; border-right: solid; border-right-color: darkblue; border-right-width: 1px; border-top: solid; border-top-color: darkblue; border-top-width: 1px; height: 250px" >
                                                        <div class="ibox-title"  style="color: black">
                                                            <h5>Dados do Lead</h5>
                                                            <span style="float: right"><a href="@Url.Action("EnviarEMailCliente", "CRM", new { id = Model.LEAD_CD_ID })" />Enviar E-Mail</span>
                                                        </div>
                                                        <div class="ibox-content" style="color: black">
                                                            <h3 style="color: green"><strong><a href="@Url.Action("EditarLead", "Lead", new { id = Model.LEAD_CD_ID })">@Model.LEAD.LEAD_NM_NOME</a></strong></h3>
                                                            <address>
                                                                @if (Model.LEAD.LEAD_NM_ENDERECO != null)
                                                                {
                                                                    @Model.LEAD.LEAD_NM_ENDERECO @Model.LEAD.LEAD_NR_NUMERO @Model.LEAD.LEAD_NM_COMPLEMENTO<br>
                                                                    @Model.LEAD.LEAD_NM_BAIRRO  @Model.LEAD.LEAD_NM_CIDADE @Model.LEAD.UF.UF_SG_SIGLA @Model.LEAD.LEAD_NR_CEP<br>
                                                                }
                                                                else
                                                                {
                                                                    <h5>Endereço não informado</h5>
                                                                }

                                                                <abbr title="Cel">C:</abbr> <a href="@Url.Action("EnviarSMSCliente", "CRM", new { id = Model.LEAD.LEAD_CD_ID })">@Model.LEAD.LEAD_NR_CELULAR</a>
                                                            </address>
                                                            <p><i class="fa fa-envelope"></i><a href="@Url.Action("EnviarEMailCliente", "CRM", new { id = Model.LEAD_CD_ID })" /> @Model.LEAD.LEAD_EM_EMAIL</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-8">
                                                    <div class="ibox float-e-margins" style="border-bottom: solid; border-bottom-color: darkblue; border-bottom-width: 1px; border-left: solid; border-left-color: darkblue; border-left-width: 1px; border-right: solid; border-right-color: darkblue; border-right-width: 1px; border-top: solid; border-top-color: darkblue; border-top-width: 1px; height: 250px" >
                                                        <div class="ibox-title" style="color: black">
                                                            <h5>Dados Básicos do Processo</h5>
                                                            @if (Model.CRM1_IN_ENCERRADO == 1)
                                                            {
                                                                <span class="badge badge-success" style="float:right">Encerrado</span>                                                        
                                                            }
                                                            @if (Model.CRM1_IN_STATUS == ViewBag.EtapaEncerra)
                                                            {
                                                                <span class="badge badge-success" style="float:right">@ViewBag.NomeEtapa</span>                                                        
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-primary" style="float:right">@ViewBag.NomeEtapa</span>                                                        
                                                            }
                                                            @if (Model.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).ToList().Count > 0)
                                                            {
                                                                <span class="badge badge-success" style="float:right">Ação Pendente</span> 
                                                                if (Model.CRM_ACAO.Where(p => p.CRAC_IN_STATUS == 1).OrderByDescending(m => m.CRAC_DT_PREVISTA).FirstOrDefault().CRAC_DT_PREVISTA.Value.Date < DateTime.Today.Date)
                                                                {
                                                                    <span class="badge badge-danger" style="float:right">Ação Atrasada</span> 
                                                                }
                                                            }
                                                        </div>
                                                        <div class="ibox-content"  style="color: black">
                                                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                                                <div class="col-lg-6 col-md-6 col-xs-12">
                                                                    Nome do Processo
                                                                    @Html.TextBoxFor(m => m.CRM1_NM_NOME, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: green; font-weight: bold" })
                                                                </div>
                                                                <div class="col-lg-3 col-md-3 col-xs-12" style="color: green; font-weight:bold">
                                                                    Funil de Processo
                                                                    @Html.TextBoxFor(m => m.FUNIL.FUNI_NM_NOME, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                                                <div class="col-lg-2 col-md-2 col-xs-12">
                                                                    Data de Criação
                                                                    @Html.TextBoxFor(m => m.CRM1_DT_CRIACAO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @id = "data1", @readonly = "readonly" })
                                                                </div>
                                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                                    Responsável
                                                                    @Html.TextBoxFor(m => m.USUARIO.USUA_NM_NOME, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                </div>
                                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                                    Origem
                                                                    @Html.TextBoxFor(m => m.CRM_ORIGEM.CROR_NM_NOME, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly" })
                                                                </div>
                                                                <div class="col-lg-2 col-md-2 col-xs-12">
                                                                    Temperatura
                                                                    @Html.DropDownListFor(m => m.CRM1_NR_TEMPERATURA, (SelectList)ViewBag.Temp, "Selecionar", new { @class = "form-control", autofocus = true })
                                                                    @Html.ValidationMessageFor(m => m.CRM1_NR_TEMPERATURA, "", new { @style = "color:red" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-lg-6">
                                                    <div class="ibox float-e-margins" style="border-bottom: solid; border-bottom-color: darkblue; border-bottom-width: 1px; border-left: solid; border-left-color: darkblue; border-left-width: 1px; border-right: solid; border-right-color: darkblue; border-right-width: 1px; border-top: solid; border-top-color: darkblue; border-top-width: 1px; height: 600px" >
                                                        <div class="ibox-title">
                                                            <h5 style="color: black">Informações do Processo</h5>
                                                            @if (Model.CRM1_IN_ATIVO == 1)
                                                            {
                                                                <span class="badge badge-primary" style="float:right">Ativo</span> 
                                                            }
                                                            @if (Model.CRM1_IN_ATIVO == 2)
                                                            {
                                                                <span class="badge badge-warning" style="float:right">Excluido</span>                                                        
                                                            }
                                                            @if (Model.CRM1_IN_ATIVO == 3)
                                                            {
                                                                <span class="badge badge-warning" style="float:right">Cancelado</span>                                                        
                                                            }
                                                            @if (Model.CRM1_IN_ATIVO == 4)
                                                            {
                                                                <span class="badge badge-danger" style="float:right">Perdido</span>                                                      
                                                            }
                                                            @if (Model.CRM1_IN_ATIVO == 5)
                                                            {
                                                                <span class="badge badge-success" style="float:right">Encerrado</span>                                                        
                                                            }
                                                        </div>

                                                        <div class="ibox-content"  style="color: black">
                                                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                                    Identificador do Processo
                                                                    @Html.TextBoxFor(m => m.CRM1_ID_IDENTIFICADOR, new { @class = "form-control", @tabindex = "-1", @readonly = "readonly", @style = "color: darkblue; font-weight: bold" })
                                                                </div>                                                              
                                                                <div class="col-lg-2 col-md-2 col-xs-12">
                                                                    Valor Estimado (R$)
                                                                    @Html.TextBoxFor(m => m.ValorInicial, "{0:n2}", new { @class = "form-control", autofocus = true })
                                                                    @Html.ValidationMessageFor(m => m.ValorInicial, "", new { @style = "color:red" })
                                                                </div>
                                                                @if (Model.CRM1_IN_STATUS == ViewBag.EtapaEncerra)
                                                                {
                                                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                                                        Valor Final
                                                                        @Html.TextBoxFor(m => m.ValorFinal, "{0:n2}", new { @class = "form-control", autofocus = true })
                                                                        @Html.ValidationMessageFor(m => m.ValorFinal, "", new { @style = "color:red" })
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                                                <div class="col-lg-12 col-md-12 col-xs-12">
                                                                    Descrição
                                                                    @Html.TextAreaFor(m => m.CRM1_DS_DESCRICAO, new { @class = "form-control", style = "width: 100%; height: 100px; overflow:auto;", autofocus = true })
                                                                    @Html.ValidationMessageFor(m => m.CRM1_DS_DESCRICAO, "", new { @style = "color:red" })
                                                                </div>
                                                            </div>
                                                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                                                <div class="col-lg-12 col-md-12 col-xs-12">
                                                                    Informações Gerais
                                                                    @Html.TextAreaFor(m => m.CRM1_TX_INFORMACOES_GERAIS, new { @class = "form-control", style = "width: 100%; height: 200px; overflow:auto;", autofocus = true })
                                                                    @Html.ValidationMessageFor(m => m.CRM1_TX_INFORMACOES_GERAIS, "", new { @style = "color:red" })
                                                                </div>
                                                            </div>
                                                            @if (Model.CRM1_IN_ATIVO == 1)
                                                            {
                                                                <div class="form-group">
                                                                    @Html.ButtonActionSubmit(text: "Confirma Alterações do Processo", htmlAttributes: new { id = "basictoast", @class = "show-spinner" })
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6 col-md-6 col-xs-12">
                                                    <h4 style="margin-left: 0px; color:green; background-color: beige; font-weight:bold">Prontuário</h4>
                                                    <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">                
                                                        <div class="col-lg-12 col-md-12 col-xs-12">
                                                            Resumo do Processo - Anotação Manual
                                                            @Html.TextAreaFor(m => m.CRM1_TX_RESUMO, new { @class = "form-control", style = "width: 100%; height: 200px; overflow:auto;", autofocus = true })
                                                            @Html.ValidationMessageFor(m => m.CRM1_TX_RESUMO, "", new { @style = "color:red" })
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">                
                                                        <div class="col-lg-12 col-md-12 col-xs-12">
                                                            Resumo dò Processo - Histórico
                                                            @Html.TextAreaFor(m => m.CRM1_TX_RESUMO_OLD, new { @class = "form-control", tabindex = "-1", style = "width: 100%; height: 2500px; overflow:auto;", @readonly = "readonly", id = "historicoProntuario"})
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="tab-1" class="tab-pane">
                                    <div class="panel-body">
                                        @using (Html.BeginForm("AcompanhamentoProcessoCRM", "CRM", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", @id = "pwd-container1" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="row">
                                                @Html.HiddenFor(m => m.ASSI_CD_ID)
                                                @Html.HiddenFor(m => m.CLIE_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_AQ_IMAGEM)
                                                @Html.HiddenFor(m => m.CRM1_CD_ID)
                                                @Html.HiddenFor(m => m.CRM1_DS_INFORMACOES_ENCERRAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DS_MOTIVO_CANCELAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DT_CANCELAMENTO)
                                                @Html.HiddenFor(m => m.CRM1_DT_CRIACAO)
                                                @Html.HiddenFor(m => m.CRM1_DT_DATA_SAIDA)
