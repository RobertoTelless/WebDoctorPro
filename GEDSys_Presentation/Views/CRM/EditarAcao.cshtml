@using Presentation.Extensions
@using Humanizer; 
@model ERP_Condominios_Solution.ViewModels.CRMAcaoViewModel
@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="page-title">
        <h3 class="title">Processos</h3>
        <br />
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaAdministra", "Administra")">Dashboard</a>
            </li>
            <li>
                <a href="@Url.Action("MontarTelaCRM", "CRM")">Processos</a>
            </li>
            <li>
                <a href="@Url.Action("VoltarAcompanhamentoCRM", "CRM")">Processo - Acompanhamento</a>
            </li>
            <li class="active">
                <strong>Ações - Alteração</strong>
            </li>
        </ol>
        <br />
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Ação - Alteração</h5>
                    @if (Model.CRAC_IN_STATUS == 1)
                    {
                        <span class="badge badge-primary" style="float:right">Ativa</span> 
                    }
                    @if (Model.CRAC_IN_STATUS == 2)
                    {
                        <span class="badge badge-warning" style="float:right">Pendente</span>                                                        
                    }
                    @if (Model.CRAC_IN_STATUS == 3)
                    {
                        <span class="badge badge-success" style="float:right">Encerrada</span>                                                        
                    }
                    @if (Model.CRAC_IN_STATUS == 4)
                    {
                        <span class="badge badge-danger" style="float:right">Excluída</span>                                                      
                    }
                </div>

                @using (Html.BeginForm("EditarAcao", "CRM", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", @id="pwd-container1" }))
                {
                    <div class="ibox-content">
                        @Html.AntiForgeryToken()
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <button type="button" class="close" data-dismiss="alert">Fechar</button>
                                @Html.ValidationSummary(false, "Erros de Crítica Encontrados:", new { @class = "text-danger" })
                            </div>
                        }
                        <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                            <div class="col-lg-12 col-md-12 col-xs-12" style="background-color: beige; color: green; font-weight: bold">
                                <h4>Caso tenha sido feito agendamento para esta ação. A alteração na hora deverá ser feita manualmente na AGENDA</h4>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.ButtonActionSubmit(text: "Confirma Alteração de Ação", htmlAttributes: new { id = "basictoast", @class = "show-spinner" })
                            @Html.ButtonLinkIndex(text: "Voltar", action: "VoltarAcaoCRM", controller: "CRM", htmlAttributes: new { @class = "show-spinner" })
                        </div>
                        <div class="row">
                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">                
                                <div class="col-lg-4 col-md-4 col-xs-12">
                                    Processo
                                    @Html.TextBoxFor(m => m.CRM.CRM1_NM_NOME, new { @class = "form-control", @tabindex = "-1", @readonly="readonly", style = "font-weight: bold; color: green;" })
                                </div>
                                <div class="col-lg-3 col-md-3 col-xs-12">
                                    Identificãdor
                                    @Html.TextBoxFor(m => m.CRM.CRM1_ID_IDENTIFICADOR, new { @class = "form-control", @tabindex = "-1", @readonly="readonly", style = "font-weight: bold; color: brown;" })
                                </div>
                            </div>
                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">                
                                <div class="col-lg-2 col-md-2 col-xs-12">
                                    Data de Criação
                                    @Html.TextBoxFor(m => m.CRAC_DT_CRIACAO, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @readonly="readonly" })
                                </div>
                                <div class="col-lg-2 col-md-2 col-xs-12">
                                    @Html.HiddenFor(m => m.CRM1_CD_ID)
                                    @Html.HiddenFor(m => m.CRAC_IN_ATIVO)
                                    @Html.HiddenFor(m => m.ASSI_CD_ID)
                                    @Html.HiddenFor(m => m.CRAC_DT_CRIACAO)
                                    @Html.HiddenFor(m => m.USUA_CD_ID1)
                                    @Html.HiddenFor(m => m.CRAC_CD_ID)
                                    @Html.HiddenFor(m => m.CRAC_IN_STATUS)
                                    @Html.HiddenFor(m => m.EMPR_CD_ID)
                                    @Html.HiddenFor(m => m.CRAC_IN_SISTEMA)
                                    @Html.HiddenFor(m => m.USUA_CD_ID2)
                                    Tipo de Ação*
                                    @Html.DropDownListFor(m => m.TIAC_CD_ID, (SelectList)ViewBag.Tipos, "Selecionar", new { @class = "form-control", autofocus = true })
                                    @Html.ValidationMessageFor(m => m.TIAC_CD_ID, "", new { @style = "color:red" })
                                </div>
                                <div class="col-lg-2 col-md-2 col-xs-12">
                                    Atribuída a
                                    @Html.TextBoxFor(m => m.USUARIO1.USUA_NM_NOME, new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: green ", @readonly="readonly" })
                                </div>
                                @if (Model.CRAC_DT_PREVISTA.Value.Date > DateTime.Today.Date)
                                {
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Data Prevista
                                        @Html.TextBoxFor(m => m.CRAC_DT_PREVISTA, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: green", @readonly="readonly" })
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Previsto Para
                                        @Html.TextBoxFor(m => m.DATA_PREVISTA, new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: green ", @readonly="readonly" })
                                    </div>
                                }
                                else if (Model.CRAC_DT_PREVISTA.Value.Date == DateTime.Today.Date)
                                {
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Data Prevista
                                        @Html.TextBoxFor(m => m.CRAC_DT_PREVISTA, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: orange", @readonly="readonly" })
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Previsto Para
                                        @Html.TextBoxFor(m => m.DATA_PREVISTA, new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: orange ", @readonly="readonly" })
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Data Prevista
                                        @Html.TextBoxFor(m => m.CRAC_DT_PREVISTA, "{0:dd/MM/yyyy}", new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: red", @readonly="readonly" })
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        Previsto Para
                                        @Html.TextBoxFor(m => m.DATA_PREVISTA, new { @class = "form-control", @tabindex = "-1", @style = "font-weight:bold; color: red ", @readonly="readonly" })
                                    </div>
                                }
                                <div class="col-lg-1 col-md-1 col-xs-12">
                                    Início
                                    @Html.TextBoxFor(m => m.CRAC_HR_INICIO, new { @class = "form-control", @tabindex = "-1", @readonly="readonly" })
                                </div>
                                <div class="col-lg-1 col-md-1 col-xs-12">
                                    Final
                                    @Html.TextBoxFor(m => m.CRAC_HR_FINAL, new { @class = "form-control", @tabindex = "-1", @readonly="readonly" })
                                </div>
                            </div>
                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">                
                                <div class="col-lg-12 col-md-12 col-xs-12">
                                    Título*
                                    @Html.TextBoxFor(m => m.CRAC_NM_TITULO, new { @class = "form-control", autofocus = true })
                                    @Html.ValidationMessageFor(m => m.CRAC_NM_TITULO, "",new { @style="color:red" })
                                </div>
                            </div>
                            <div class="form-group" style=" margin-left: -15px; margin-right: -15px;">
                                <div class="col-lg-12 col-md-12 col-xs-12">
                                    Descrição*
                                    @Html.TextAreaFor(m => m.CRAC_DS_DESCRICAO, new { @class = "form-control", style = "width: 100%; height: 200px; overflow:auto;", autofocus = true })
                                    @Html.ValidationMessageFor(m => m.CRAC_DS_DESCRICAO, "", new { @style = "color:red" })
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
         </div>
    </div>
</div>


@section Styles {
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/themes/base/all.css" rel="stylesheet" />
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/jasnyBootstrapStyles")
    @Styles.Render("~/plugins/toastrStyles")

        <style>
        /* 1. Aumenta a largura e garante o espaço interno */
        #toast-container > .toast {
            width: 500px !important; 
            max-width: 500px !important;
            opacity: 0.95 !important;
        }

        /* 2. Remove o ícone nativo do Toastr (Background Image) */
        #toast-container > .toast-success {
            background-image: none !important;
        }

        /* 3. Remove ícones do FontAwesome/Inspinia injetados via ::before no Título */
        .toast-success .toast-title::before, 
        .toast-success .toast-title::after,
        .toast-success::before {
            content: none !important;
            display: none !important;
        }

        /* 4. Ajusta o recuo do texto já que removemos o ícone */
        .toast-success .toast-title, 
        .toast-success .toast-message {
            padding-left: 10px !important;
        }
    </style>

}
@section Scripts {
    @Scripts.Render("~/plugins/toastr")
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/bundles/inputmask")
    @Scripts.Render("~/plugins/jasnyBootstrap")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskedinput/1.4.1/jquery.maskedinput.js"></script>
    <script src="~/Scripts/uploadAnexo.js"></script>

    <script type="text/javascript" src="~/Scripts/moment.min.js"></script>
    <script type="text/javascript" src="~/Scripts/bootstrap.min.js"></script>
   
    <script type="text/javascript">
        $(document).ready(function () {
            $('[data-toggle="popover"]').popover();
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });
        });
    </script>

    <!-- Handler de fechamento do browser -->
    <script type="text/javascript">
        window.onbeforeunload = function ()
        {
            navigator.sendBeacon('../ControleAcesso/LogSessionTime');
        }; 
    </script>

    <script type="text/javascript">
        $(document).ready(function () {

            var i = -1;
            var toastCount = 0;
            var $toastlast;
            var getMessage = function () {
                var msg = 'Hi, welcome to Inspinia. This is example of Toastr notification box.';
                return msg;
            };

            $('#basictoast').click(function () {
                // Display a success toast, with a title
                toastr.success('Alteração em andamento!')
            });
            $('#showtoast').click(function () {
                var shortCutFunction = $("#toastTypeGroup input:radio:checked").val();
                var msg = $('#message').val();
                var title = $('#title').val() || '';
                var $showDuration = $('#showDuration');
                var $hideDuration = $('#hideDuration');
                var $timeOut = $('#timeOut');
                var $extendedTimeOut = $('#extendedTimeOut');
                var $showEasing = $('#showEasing');
                var $hideEasing = $('#hideEasing');
                var $showMethod = $('#showMethod');
                var $hideMethod = $('#hideMethod');
                var toastIndex = toastCount++;
                toastr.options = {
                    closeButton: $('#closeButton').prop('checked'),
                    debug: $('#debugInfo').prop('checked'),
                    progressBar: $('#progressBar').prop('checked'),
                    positionClass: $('#positionGroup input:radio:checked').val() || 'toast-top-right',
                    onclick: null
                };
                if ($('#addBehaviorOnToastClick').prop('checked')) {
                    toastr.options.onclick = function () {
                        alert('You can perform some custom action after a toast goes away');
                    };
                }
                if ($showDuration.val().length) {
                    toastr.options.showDuration = $showDuration.val();
                }
                if ($hideDuration.val().length) {
                    toastr.options.hideDuration = $hideDuration.val();
                }
                if ($timeOut.val().length) {
                    toastr.options.timeOut = $timeOut.val();
                }
                if ($extendedTimeOut.val().length) {
                    toastr.options.extendedTimeOut = $extendedTimeOut.val();
                }
                if ($showEasing.val().length) {
                    toastr.options.showEasing = $showEasing.val();
                }
                if ($hideEasing.val().length) {
                    toastr.options.hideEasing = $hideEasing.val();
                }
                if ($showMethod.val().length) {
                    toastr.options.showMethod = $showMethod.val();
                }
                if ($hideMethod.val().length) {
                    toastr.options.hideMethod = $hideMethod.val();
                }
                if (!msg) {
                    msg = getMessage();
                }
                $("#toastrOptions").text("Command: toastr["
                        + shortCutFunction
                        + "](\""
                        + msg
                        + (title ? "\", \"" + title : '')
                        + "\")\n\ntoastr.options = "
                        + JSON.stringify(toastr.options, null, 2)
                );
                var $toast = toastr[shortCutFunction](msg, title); // Wire up an event handler to a button in the toast, if it exists
                $toastlast = $toast;
                if ($toast.find('#okBtn').length) {
                    $toast.delegate('#okBtn', 'click', function () {
                        alert('you clicked me. i was toast #' + toastIndex + '. goodbye!');
                        $toast.remove();
                    });
                }
                if ($toast.find('#surpriseBtn').length) {
                    $toast.delegate('#surpriseBtn', 'click', function () {
                        alert('Surprise! you clicked me. i was toast #' + toastIndex + '. You could perform an action here.');
                    });
                }
            });
            function getLastToast() {
                return $toastlast;
            }
            $('#clearlasttoast').click(function () {
                toastr.clear(getLastToast());
            });
            $('#cleartoasts').click(function () {
                toastr.clear();
            });

        });
    </script>

    @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                  alert("@ViewBag.Message");
            };
        </script>
    }
}

