@using Presentation.Extensions
@model ERP_Condominios_Solution.ViewModels.NoticiaViewModel
@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}
<div class="wrapper wrapper-content animated fadeInRight">
    <div class="page-title"> 
        <h3 class="title">Notícias</h3> 
        <br />
        <ol class="breadcrumb">
            <li>
                <a href="@Url.Action("MontarTelaPaciente", "Paciente")">Dashboard</a>
            </li>
            <li class="active">
                <strong>Notícia - Visualização</strong>
            </li>
        </ol>
        <br />
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 col-xs-12">
            <div class="col-lg-12 col-md-12 col-xs-12 ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Notícia - Visualização</h5>
                </div>
                <div class="ibox-content">
                    <div class="form-group">
                        <br />
                        @Html.ButtonLinkIndex(text: "Voltar", action: "MontarTelaAreaPaciente", controller: "AreaPaciente", htmlAttributes: new { @class = "show-spinner" })
                    </div>
                    <div class="form-group text-center" style="display: block; width: 100%;">
                        <br />
                        <img src="@Model.FotoAzureUrl" 
                             style="display: inline-block; max-height: 500px; max-width: 700px; height: auto; width: auto;" 
                             alt="Notícia">
                    </div>

                    <div class="text-center article-title">
                        <span class="text-muted"><i class="fa fa-clock-o"></i> @Model.NOTC_DT_DATA_AUTOR.Value.ToLongDateString()</span>
                        <br /><br />
                        <h1>
                            @Model.NOTC_NM_TITULO
                        </h1>
                        <h4>
                            @Model.NOTC_NM_AUTOR
                        </h4>
                        <h4>
                            <a href="@Model.NOTC_LK_LINK" target="_blank">@Model.NOTC_LK_LINK</a>
                        </h4>
                    </div>
                    <div>
                        <br />
                        @Model.NOTC_TX_TEXTO
                        <br />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="small text-right">
                                <br />
                                <h5>Stats:</h5>
                                <div> <i class="fa fa-comments-o"> </i> @Model.NOTICIA_COMENTARIO.Count comentários </div>
                                <i class="fa fa-eye"> </i> @Model.NOTC_NR_ACESSO visualizações
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <br />
                        @Html.ButtonLinkIndex(text: "Novo Comentário", action: "IncluirComentarioNoticia", controller: "Noticia", htmlAttributes: new { @class = "show-spinner" })
                        <br />
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <h2>Comentários:</h2>
                                @if (Model.NOTICIA_COMENTARIO.Count > 0)
                                {
                                    foreach (var item in (Model.NOTICIA_COMENTARIO).OrderByDescending(a => a.NOCO_DT_COMENTARIO))
                                    {
                                        <div class="social-feed-box">
                                            <div class="social-avatar">
                                                <a href="#" class="pull-left">
                                                    @{
                                                        // Definimos a URL base do seu storage
                                                        string storageUrl = "https://rtistoragemain.blob.core.windows.net/rti-datacontainer/";
        
                                                        // Pegamos o caminho que está no banco e removemos o "~"
                                                        string fotoPath = item.USUARIO.USUA_AQ_FOTO != null 
                                                                            ? item.USUARIO.USUA_AQ_FOTO.Replace("~", "") 
                                                                            : "Imagens/Base/foto_padrao.png"; // Fallback caso não tenha foto

                                                        // Montamos a URL completa
                                                        string fullImageUrl = storageUrl + fotoPath.TrimStart('/');
                                                    }
    
                                                    <img src="@fullImageUrl" 
                                                            style="width: auto; height: auto; max-height: 110px; max-width: 90px;" 
                                                            alt="Foto do Usuário">
                                                </a>
                                                <div class="media-body">
                                                    <a href="#">
                                                        @item.USUARIO.USUA_NM_NOME
                                                    </a>
                                                    <small class="text-muted">@item.NOCO_DT_COMENTARIO.Value.ToLongDateString() as @item.NOCO_DT_COMENTARIO.Value.ToShortTimeString()</small>
                                                </div>
                                            </div>
                                            <div class="social-body">
                                                <p>
                                                    <span style="white-space: pre-wrap;">@item.NOCO_DS_COMENTARIO</span>
                                                </p>
                                            </div>
                                        </div>
                                    }
                                }
                        </div>
                    </div>
                </div>
            </div>
         </div>
    </div>
</div>

@section Styles {
    <link href="~/Content/themes/base/all.css" rel="stylesheet" />  
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/jasnyBootstrapStyles")
}
@section Scripts {
   
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/bundles/inputmask")
    @Scripts.Render("~/plugins/jasnyBootstrap")
    @Scripts.Render("~/plugins/sparkline")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskedinput/1.4.1/jquery.maskedinput.js"></script>
    @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                  alert("@ViewBag.Message");
            };
        </script>
    }
}
