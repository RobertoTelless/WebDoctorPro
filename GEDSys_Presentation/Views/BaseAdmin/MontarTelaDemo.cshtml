@using Presentation.Extensions
@using CrossCutting;
@model ERP_Condominios_Solution.ViewModels.FaleConoscoViewModel
@{
    Layout = "~/Views/Shared/_Layout_Limpo.cshtml";
    ViewBag.Title = "WebDoctor - Contratação";
}

<style>
    /* Estilização moderna acoplada preservando a paleta original */
    :root {
        --cor-primaria: #1ab394;
        --cor-primaria-hover: #18a689;
        --cor-azul-base: #0b3961;
        --cor-azul-escuro: #0a2540;
        --bg-cinza: #f8fafc;
        --bg-alerta-verde: #f0fdf4;
        --borda-suave: #e2e8f0;
    }

    .card-moderno {
        background: #ffffff;
        border: 1px solid var(--borda-suave);
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(11, 57, 97, 0.04);
        padding: 25px;
        margin-bottom: 25px;
    }

    .header-painel {
        border-bottom: 2px solid var(--cor-azul-base);
        padding-bottom: 12px;
        margin-bottom: 25px;
    }

    .header-painel h4 {
        color: var(--cor-azul-base);
        font-weight: 700;
        font-size: 18px;
        margin: 0;
    }

    .subsecao-titulo {
        color: var(--cor-primaria);
        font-weight: 700;
        margin-top: 25px;
        margin-bottom: 15px;
        clear: both; /* Garante que elementos flutuantes do Bootstrap não causem sobreposição */
        border-left: none !important; /* Remove a barra verde vertical de vez */
        padding-left: 0 !important;   /* Alinha o texto perfeitamente à esquerda sem o recuo da barra */
    }

    .box-info-verde {
        background-color: var(--bg-alerta-verde);
        border-left: 4px solid var(--cor-primaria);
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 20px;
    }

    .box-info-regras {
        background-color: #fafafa;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
        padding: 20px;
    }

    .form-control-moderno {
        border-radius: 6px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 8px 12px !important;
        height: auto !important;
        transition: all 0.2s ease;
        background-color: var(--bg-cinza);
        width: 100%;
    }

    .form-control-moderno:focus {
        border-color: var(--cor-primaria) !important;
        background-color: #ffffff;
        box-shadow: 0 0 0 3px rgba(26, 179, 148, 0.15);
    }

    .btn-voltar-container {
        margin-bottom: 20px;
    }

    /* Grid responsivo controlado */
    .row-compacto {
        margin-left: -10px;
        margin-right: -10px;
    }
    .row-compacto > [class*="col-"] {
        padding-left: 10px;
        padding-right: 10px;
        margin-bottom: 15px;
    }

    .btn-loading1, .btn-loading2 {
        white-space: normal !important;
        word-wrap: break-word !important;
        text-align: center;
        width: 100%;
    }

    /* ----------------------------------------------------------- */
    /* Regras de Responsividade Mobile                             */
    /* ----------------------------------------------------------- */
    @@media (max-width: 991px) {
        .box-info-regras {
            margin-top: 15px;
        }
    }

    @@media (max-width: 768px) {
        .card-moderno {
            padding: 15px;
        }
        
        .ibox-title h2 {
            font-size: 20px !important;
        }

        .ibox-heading h3 {
            font-size: 15px !important;
        }

        .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-lg-7, .col-lg-8,
        .col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-md-7, .col-md-8,
        .col-xs-4, .col-xs-8, .col-xs-12 {
            width: 100% !important;
            float: none !important;
        }

        .input-group {
            display: flex !important;
            width: 100%;
        }
        
        .input-group .form-control {
            flex: 1;
        }

        .input-group-btn {
            width: auto !important;
        }

        #btnBuscaCep {
            padding: 8px 10px !important;
            font-size: 12px !important;
        }
        
        .form-group-custom-mobile {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }
    }
</style>

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                
                <div class="ibox-title" style="border-bottom: 1px solid var(--borda-suave); padding-bottom: 15px;">
                    <h2 style="font-weight: 800; color: var(--cor-azul-escuro); margin:0;">Solicitação de Assinatura de Demonstração do WebDoctorPro</h2>
                </div>
                
                <div class="ibox-content" style="background: transparent; border: none; padding: 20px 0;">
                    <div class="btn-voltar-container">
                        @Html.ButtonLinkIndex(text: "Voltar", controller: "BaseAdmin", action: "CarregarLandingPage", htmlAttributes: new { @class = "btn btn-default show-spinner", @style = "border-radius: 4px; font-weight: 600;" })
                    </div>

                    <div class="ibox-content ibox-heading" style="background: linear-gradient(135deg, var(--cor-azul-base) 0%, var(--cor-azul-escuro) 100%); color: #ffffff; border-radius: 6px; padding: 20px; border: none; margin-bottom: 25px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                        <h3 style="margin: 0; line-height: 1.4; font-weight: 500;">
                            <i class="fa fa-credit-card" style="margin-right: 8px; color: var(--cor-primaria);"></i> 
                            Solicite uma assinatura de demonstração com validade de 30 dias e use o <b>WebDoctorPro</b> sem limites e sem nenhum custo.
                        </h3>
                    </div>

                    <div class="card-moderno">
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" style="border-radius: 6px;">
                                <button type="button" class="close" data-dismiss="alert">Fechar</button>
                                @Html.ValidationSummary(false, "", new { @class = "text-danger", @style = "font-weight: 600;" })
                            </div>
                        }

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-xs-12">
                                <div class="header-painel">
                                    <h4><i class="fa fa-file-signature" style="color: var(--cor-primaria); margin-right: 6px;"></i> Formulário de Solicitação</h4>
                                </div>
                                
                                @using (Html.BeginForm("MontarTelaDemo", "BaseAdmin", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-vertical", @id = "pwd-container1" }))
                                {
                                    <div class="box-info-verde">
                                        <h5 style="color: #166534; font-weight: 700; margin: 0 0 4px 0;"><i class="fa fa-info-circle"></i> Orientações Importantes</h5>
                                        <p style="color: #166534; margin: 0; font-size: 13px;">Preencha os campos abaixo com as informações solicitadas. Assim que confirmar a solicitação, você receberá um e-mail de validação contendo suas credenciais de acesso.</p>
                                    </div>

                                    <div class="row" id="Botoes" style="margin-bottom: 15px;">
                                        <div class="col-lg-12 col-md-12 col-xs-12" id="Basico">
                                            @Html.ButtonActionSubmit(text: "Confirmação da Solicitação de Assinatura de Demonstração", htmlAttributes: new { id = "basictoast", @class = "btn btn-primary btn-loading1 show-spinner", @style = "border-radius: 4px; font-weight: 700; width: 100%;" })
                                            <div style="margin-top: 5px; text-align: center;">
                                                <span id="loadingIndicator" style="display: none; color: var(--cor-azul-base); font-weight: 600;">
                                                    <i class="fa fa-spinner fa-spin"></i> Processando...
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row-compacto">
                                        <div class="col-lg-12 col-md-12 col-xs-12">
                                            <h3 class="subsecao-titulo">Identificação</h3>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-xs-12" id="tipoAss">
                                            <label style="font-weight: 600;">Tipo de Assinante*</label>
                                            @Html.DropDownListFor(m => m.Tipo, (SelectList)ViewBag.Assunto, "Selecionar", new { @class = "form-control form-control-moderno", autofocus = true, @id = "tipo", onchange = "ValidaTipo($(this).val())" })
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-xs-12" style="display: none" id="CPF">
                                            <label style="font-weight: 600;">CPF*</label>
                                            @Html.TextBoxFor(m => m.CPF, new { @class = "form-control form-control-moderno", @id = "cpf" })
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-xs-12" style="display: none" id="CNPJ">
                                            <label style="font-weight: 600;">CNPJ*</label>
                                            @Html.TextBoxFor(m => m.CPF, new { @class = "form-control form-control-moderno", @id = "cnpj" })
                                        </div>

                                        <div class="col-lg-6 col-md-6 col-xs-12">
                                            <label style="font-weight: 600;">Nome do Assinante*</label>
                                            @Html.TextBoxFor(m => m.Nome, new { @class = "form-control form-control-moderno", @id = "nome" })
                                        </div>

                                        <div class="col-lg-6 col-md-6 col-xs-12" style="display: none" id="Razao">
                                            <label style="font-weight: 600;">Razão Social*</label>
                                            @Html.TextBoxFor(m => m.Razao, new { @class = "form-control form-control-moderno", @id = "razao" })
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-xs-12">
                                            <h3 class="subsecao-titulo">Informações de Contato</h3>
                                        </div>

                                        <div class="col-lg-6 col-md-6 col-xs-12">
                                            <label style="font-weight: 600;">E-Mail*</label>
                                            @Html.TextBoxFor(m => m.Resposta, new { @class = "form-control form-control-moderno", @id = "mail" })
                                        </div>

                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                            <label style="font-weight: 600;">Telefone</label>
                                            @Html.TextBoxFor(m => m.TelefoneFixo, new { @class = "form-control form-control-moderno", @id = "tel" })
                                        </div>

                                        <div class="col-lg-3 col-md-3 col-xs-12">
                                            <label style="font-weight: 600;">Celular</label>
                                            @Html.TextBoxFor(m => m.Celular, new { @class = "form-control form-control-moderno", @id = "cel" })
                                        </div>

                                        <div class="col-lg-8 col-md-8 col-xs-12">
                                            <h3 class="subsecao-titulo">Login e Senha</h3>
                                            <div class="row-compacto form-group-custom-mobile" style="margin-bottom: 20px;">
                                                <div class="col-lg-4 col-md-4 col-xs-12">
                                                    <label style="font-weight: 600;">Login*</label>
                                                    @Html.TextBoxFor(m => m.LoginBase, new { @class = "form-control form-control-moderno", data_toggle = "popover", data_content = "Informe o login para o usuário master do novo assinante. Pode ter até 10 caracteres sem espaços", data_trigger = "hover", data_placement = "top" })
                                                    @Html.ValidationMessageFor(m => m.Login, "", new { @style = "color:red; font-size:11px;" })
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-xs-12">
                                                    <label style="font-weight: 600;">Senha*</label>
                                                    @Html.TextBoxFor(m => m.SenhaBase, new { @class = "form-control form-control-moderno pwd1", @type = "password", @id = "Password1" })
                                                    @Html.ValidationMessageFor(m => m.SenhaBase, "", new { @style = "color:red; font-size:11px;" })
                                                </div>
                                                <div class="col-lg-4 col-md-4 col-xs-12">
                                                    <label style="font-weight: 600;">Confirmação da Senha*</label>
                                                    @Html.TextBoxFor(m => m.SenhaBaseConfirma, new { @class = "form-control form-control-moderno", @type = "password" })
                                                    @Html.ValidationMessageFor(m => m.SenhaBaseConfirma, "", new { @style = "color:red; font-size:11px;" })
                                                </div>
                                                <div class="col-lg-12 col-md-12 col-xs-12">
                                                    <div class="pwstrength_viewport_progress" style="margin-top: 5px;"></div>
                                                </div>
                                            </div>

                                            <h3 class="subsecao-titulo">Endereço</h3>
                                            <div class="row-compacto form-group-custom-mobile">
                                                <div class="col-lg-4 col-md-4 col-xs-12">
                                                    <label style="font-weight: 600;">CEP*</label>
                                                    <div class="input-group">
                                                        @Html.TextBoxFor(m => m.CEP, new { @class = "form-control form-control-moderno", @id = "cep", @onblur = "PesquisaCep($('#cep').val(), $(this), 1)" })
                                                        <span class="input-group-btn">
                                                            <span class="btn btn-warning" id="btnBuscaCep" style="height: 36px; padding: 8px 12px;" data_toggle = "popover" data_content = "Pesquisar o CEP informado" data_trigger="hover" data_placement="top" onclick="PesquisaCep($('#cep').val(), $(this), 1)">Buscar CEP</span>
                                                        </span>
                                                    </div>
                                                    @Html.ValidationMessageFor(m => m.CEP, "", new { @style = "color:red; font-size:11px;" })
                                                    <div style="display:none; color: red; margin-top: 5px;" id="cepval">
                                                        <h5><i class="fa fa-exclamation-triangle"></i> CEP inválido</h5>
                                                    </div>
                                                </div>

                                                <div class="col-lg-8 col-md-8 col-xs-12">
                                                    <label style="font-weight: 600;">Endereço</label>
                                                    @Html.TextBoxFor(m => m.Endereco, new { @class = "form-control form-control-moderno", @id = "endereco" })
                                                    @Html.ValidationMessageFor(m => m.Endereco, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                    <label style="font-weight: 600;">Número</label>
                                                    @Html.TextBoxFor(m => m.Numero, new { @class = "form-control form-control-moderno", @id = "nmr" })
                                                    @Html.ValidationMessageFor(m => m.Numero, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-5 col-md-5 col-xs-12">
                                                    <label style="font-weight: 600;">Complemento</label>
                                                    @Html.TextBoxFor(m => m.Complemento, new { @class = "form-control form-control-moderno", @id = "complemento" })
                                                    @Html.ValidationMessageFor(m => m.Complemento, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-4 col-md-4 col-xs-12">
                                                    <label style="font-weight: 600;">Bairro</label>
                                                    @Html.TextBoxFor(m => m.Bairro, new { @class = "form-control form-control-moderno", @id = "bairro" })
                                                    @Html.ValidationMessageFor(m => m.Bairro, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-6 col-md-6 col-xs-12">
                                                    <label style="font-weight: 600;">Cidade</label>
                                                    @Html.TextBoxFor(m => m.Cidade, new { @class = "form-control form-control-moderno", @id = "cidade" })
                                                    @Html.ValidationMessageFor(m => m.Cidade, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                    <label style="font-weight: 600;">UF</label>
                                                    @Html.DropDownListFor(m => m.UF, (SelectList)ViewBag.UF, "UF", new { @class = "form-control form-control-moderno", @id = "uf" })
                                                    @Html.ValidationMessageFor(m => m.UF, "", new { @style = "color:red; font-size:11px;" })
                                                </div>

                                                <div class="col-lg-3 col-md-3 col-xs-12">
                                                    <label style="font-weight: 600;">CEP Base</label>
                                                    @Html.TextBoxFor(m => m.CEPBase, new { @class = "form-control form-control-moderno", @id = "cepBase", @readonly = "readonly", @style="background-color: #e2e8f0;" })
                                                    @Html.ValidationMessageFor(m => m.CEPBase, "", new { @style = "color:red; font-size:11px;" })
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-4 col-md-4 col-xs-12" style="margin-top: 25px;">
                                            <div class="box-info-regras">
                                                <h4 style="color: #15803d; font-weight: 700; margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                                                    <i class="fa fa-shield-halved"></i> Segurança da Senha
                                                </h4>
                                                <ul style="margin:0; padding-left:18px; list-style-type:disc; color: #475569; font-size: 13px;">
                                                    <li style="margin-bottom:6px; line-height:1.3;">Não pode ser igual à anterior</li>
                                                    <li style="margin-bottom:6px; line-height:1.3;">Tem que ter no mínimo 3 caracteres</li>
                                                    <li style="margin-bottom:6px; line-height:1.3;">Tem que ter pelo menos uma letra maiúscula</li>
                                                    <li style="margin-bottom:6px; line-height:1.3;">Tem que ter pelo menos uma letra minúscula</li>
                                                    <li style="margin-bottom:6px; line-height:1.3;">Tem que ter pelo menos um dígito (0-9)</li>
                                                    <li style="margin-bottom:6px; line-height:1.3;">Tem que ter pelo menos um caractere especial (# $ % &)</li>
                                                    <li style="margin-bottom:0; line-height:1.3; color: #b91c1c;">Não pode conter os caracteres (+ - * / =)</li>
                                                </ul>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-xs-12" style="margin-top: 30px; border-top: 1px solid var(--borda-suave); padding-top: 20px;">
                                            @Html.ButtonActionSubmit(text: "Confirmação da Solicitação de Assinatura de Demonstração", htmlAttributes: new { id = "basictoast", @class = "btn btn-primary btn-loading2 show-spinner", @style = "padding: 12px 24px; font-weight: 700; border-radius: 6px; width: 100%;" })
                                            <div style="margin-top: 5px; text-align: center;">
                                                <span id="loadingIndicator1" style="display: none; color: var(--cor-azul-base); font-weight: 600;">
                                                    <i class="fa fa-spinner fa-spin"></i> Processando...
                                                </span>
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700' rel='stylesheet' type='text/css'>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <link href="~/Content/themes/base/all.css" rel="stylesheet" />
    @Styles.Render("~/Content/plugins/dataTables/dataTablesStyles")
    @Styles.Render("~/plugins/jasnyBootstrapStyles")
    @Styles.Render("~/plugins/toastrStyles")
    @Styles.Render("~/Content/css")
    @Styles.Render("~/font-awesome/css")
    @Styles.Render("~/Content/Spinner_Style.css")
    <link href="@Url.Content("~/Scripts/plugins/jquery-ui/jquery-ui.min.css")" rel="stylesheet" type="text/css" />

    <style>
        #toast-container > .toast {
            width: 500px !important; 
            max-width: 100% !important;
            opacity: 0.95 !important;
        }

        #toast-container > .toast-success {
            background-image: none !important;
        }

        .toast-success .toast-title::before, 
        .toast-success .toast-title::after,
        .toast-success::before {
            content: none !important;
            display: none !important;
        }

        .toast-success .toast-title, 
        .toast-success .toast-message {
            padding-left: 10px !important;
        }
    </style>
    <style>
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .status-badge::before {
            content: "";
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .status-pending { background-color: #fef9c3; color: #a16207; }
        .status-pending::before { background-color: #ca8a04; }
        .status-active { background-color: #dcfce7; color: #15803d; }
        .status-active::before { background-color: #16a34a; }
        .status-cancel { background-color: #fee2e2; color: #b91c1c; }
        .status-cancel::before { background-color: #dc2626; }
        .status-finish { background-color: #dbeafe; color: #1e40af; }
        .status-finish::before { background-color: #2563eb; }
        .status-overdue { background-color: #f3f4f6; color: #4b5563; }
        .status-overdue::before { background-color: #6b7280; }
    </style>
}

@section Scripts {
    @Scripts.Render("~/plugins/toastr")
    <script src="~/Scripts/jquery-ui-1.12.1.min.js"></script>
    @Scripts.Render("~/plugins/dataTables")
    @Scripts.Render("~/bundles/inputmask")
    @Scripts.Render("~/plugins/jasnyBootstrap")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskedinput/1.4.1/jquery.maskedinput.js"></script>
    <script src="~/Scripts/uploadAnexo.js"></script>
    <script type="text/javascript" src="~/Scripts/moment.min.js"></script>
    <script type="text/javascript" src="~/Scripts/bootstrap.min.js"></script>
    @Scripts.Render("~/plugins/passwordMeter")
    
    <script type="text/javascript">
        $(document).ready(function () {
            $('[data-toggle="popover"]').popover();
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.btn-loading1').on('click', function (e) {
                var $this = $(this);
                var tagName = $this.prop('tagName').toLowerCase();
                $this.addClass('disabled'); 
                $('#loadingIndicator').show();

                if (tagName === 'a') {
                    e.preventDefault();
                    var targetUrl = $this.attr('href');
                    window.location.href = targetUrl;
                } else if (tagName === 'button' || tagName === 'input') {               
                    $this.closest('form').submit();
                    $this.prop('disabled', true);
                }
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('.btn-loading2').on('click', function (e) {
                var $this = $(this);
                var tagName = $this.prop('tagName').toLowerCase();
                $this.addClass('disabled'); 
                $('#loadingIndicator1').show();

                if (tagName === 'a') {
                    e.preventDefault();
                    var targetUrl = $this.attr('href');
                    window.location.href = targetUrl;
                } else if (tagName === 'button' || tagName === 'input') {               
                    $this.closest('form').submit();
                    $this.prop('disabled', true);
                }
            });
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            var options1 = {};
            options1.ui = {
                container: "#pwd-container1",
                showVerdictsInsideProgressBar: true,
                viewports: {
                    progress: ".pwstrength_viewport_progress"
                }
            };
            options1.common = {
                debug: false,
            };
            $('.pwd1').pwstrength(options1);
        });
    </script>
   
    <script type="text/javascript">
        $(function () {
            $("#tel").mask("(99)9999-9999");
            $("#cel").mask("(99)99999-9999");
            $("#cpf").mask("999.999.999-99");
            $("#cnpj").mask("99.999.999/9999-99");
            $("#cep").mask("99999-999");
            $("#cepBase").mask("99999-999");
        });
    </script>

    <script type="text/javascript">
        function ValidaTipo(valTipo) {
            if (valTipo == '1') {
                $("#CPF").show();
                $("#CNPJ").hide();
            } else {
                $("#CPF").hide();
                $("#CNPJ").show();
            }
        }
        $(document).ready(function () {
            ValidaTipo($('#tipo').val());
        });
    </script>
    <script type="text/javascript">
        function ValidaDemo(valTipo) {
            if (valTipo == '1') {
                $("#CPFDemo").show();
            } else {
                $("#CPFDemo").hide();
            }
        }
        $(document).ready(function () {
            ValidaDemo($('#tipoDemo').val());
        });
    </script>
    <script type="text/javascript">
        function ValidaPlano(valTipo) {
            if (valTipo == '1') {
                $("#pagamento").show();
                $("#Basico").show();
                $("#Super").hide();
                $("#SuperFinanceiro").hide();
            } else if (valTipo == '2'){
                $("#pagamento").show();
                $("#Basico").hide();
                $("#Super").show();
                $("#SuperFinanceiro").hide();
            } else if (valTipo == '3'){
                $("#pagamento").show();
                $("#Basico").hide();
                $("#Super").hide();
                $("#SuperFinanceiro").show();
            }
        }
        $(document).ready(function () {
            ValidaPlano($('#plano').val());
        });
    </script>
    
    <script>
        function PesquisaCep(cep, btn, tipoEnd) {
            data = {
                cep: cep,
                tipoEnd: tipoEnd
            }
            $.ajax({
                url: '../Paciente/PesquisaCEP_Javascript',
                type: 'POST',
                data: data,
                success: function (r) {
                    if (r.Sucesso == 0) {
                        if (tipoEnd == 1) {
                            $("#cepval").show();
                        }
                    }
                    else {
                        $("#cepval").hide();
                        $("#cepval1").hide();
                        if (tipoEnd == 1) {
                            $('#endereco').val(r.PACI_NM_ENDERECO);
                            $('#nmr').val(r.PACI_NR_NUMERO);
                            $('#bairro').val(r.PACI_NM_BAIRRO);
                            $('#cidade').val(r.PACI_NM_CIDADE);
                            $('#cepBase').val(r.PACI_NR_CEP);
                            $('#uf option[value="' + r.UF_CD_ID + '"]').attr("selected", "selected");
                            $('#btnBuscaCep').removeAttr("disabled");
                        }
                    }
                }
            });
        }
    </script>

    <script>
        function GetLogin(id) {
            if (id == '1') {
                var data = {
                    id: id
                }
                $.ajax({
                    url: '../BaseAdmin/GetLogin',
                    type: 'POST',
                    data: data,
                    success: function (r) {
                        $('#cpf').val(r.CPF);
                        $('#cnpj').val(r.CNPJ);
                        $('#nome').val(r.Nome);
                        $('#razao').val(r.Razao);
                        $('#mail').val(r.Resposta);
                        $('#tel').val(r.Telefone);
                        $('#cel').val(r.Celular);
                        $('#cep').val(r.CEP);
                        $('#endereco').val(r.Endereco);
                        $('#nmr').val(r.Numero);
                        $('#complemento').val(r.Complemento);
                        $('#bairro').val(r.Bairro);
                        $('#cidade').val(r.Cidade);
                        $('#uf option[value="' + r.UF + '"]').attr("selected", "selected");

                        $('#novo').show();
                        $('#tipo').hide();
                        $('#existe').hide();
                    }
                });
            } 
        }
    </script>

    <div class="modal fade" id="modalAssinaturaSucesso" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #1ab394; color: white; border-radius: 4px 4px 0 0;">
                    <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Fechar</span></button>
                    <h4 class="modal-title"><i class="fa fa-check-circle"></i> WebDoctorPro</h4>
                </div>
                <div class="modal-body">
                    <p style="font-size: 16px; color: #676a6c; text-align: center; margin-top: 15px;">
                        Sua assinatura de demonstração está sendo criada nesse momento. 
                        Você receberá um e-mail dentro de instantes com as instruções de uso. 
                        <br /><br />
                        <strong>Obrigado por escolher o WebDoctorPro!</strong>
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal" style="border-radius: 4px; padding-left: 30px; padding-right: 30px;">OK</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function exibirModalSucesso() {
            $('#modalAssinaturaSucesso').modal({
                backdrop: 'static',
                keyboard: false
            });
            $('#modalAssinaturaSucesso').modal('show');
        }

        $(document).ready(function () {
            @if (TempData["ExibirSucesso"] != null && (bool)TempData["ExibirSucesso"])
            {
                <text>exibirModalSucesso();</text>
            }
        });
    </script>

    <style>
        .modal-dialog-centered {
            display: flex;
            align-items: center;
            min-height: calc(100% - 1rem);
        }
        
        @@media (min-width: 576px) {
            .modal-dialog-centered {
                min-height: calc(100% - 3.5rem);
            }
        }
    </style>

    <script type="text/javascript">
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "preventDuplicates": false,
                "positionClass": "toast-top-right",
                "onclick": null,
                "showDuration": "400",
                "hideDuration": "1000",
                "timeOut": "15000",
                "extendedTimeOut": "5000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            var msgSucesso = '@TempData["MensagemAcerto"]';
            if (msgSucesso != '') {
                toastr.success(msgSucesso, 'Sucesso!');
            }

            var msgErro = '@TempData["MensagemErro"]';
            if (msgErro != '') {
                toastr.error(msgErro, 'Erro!');
            }
        });
    </script>
