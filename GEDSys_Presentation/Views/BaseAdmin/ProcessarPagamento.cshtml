@using Presentation.Extensions
@using CrossCutting;
@model ERP_Condominios_Solution.ViewModels.FaleConoscoViewModel
@{
    Layout = "~/Views/Shared/_Layout_Limpo.cshtml";
    ViewBag.Title = "WebDoctor - Pagamento";

    // Captura direta do valor decimal já tipado
    decimal precoTotal = Model != null ? Model.Preco : 0;
}

<style>
    :root {
        --cor-primaria: #1ab394;
        --cor-primaria-hover: #18a689;
        --cor-azul-base: #0b3961;
        --cor-azul-escuro: #0a2540;
        --bg-cinza: #f8fafc;
        --borda-suave: #e2e8f0;
    }

    .card-moderno {
        background: #ffffff;
        border: 1px solid var(--borda-suave);
        border-radius: 8px;
        box-shadow: 0 4px 12px rgba(11, 57, 97, 0.04);
        padding: 25px;
        margin-bottom: 25px;
    }

    .form-control-moderno {
        border-radius: 6px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 8px 12px !important;
        height: auto !important;
        width: 100%;
        background-color: var(--bg-cinza);
    }

    .form-control-moderno:focus {
        border-color: var(--cor-primaria) !important;
        background-color: #ffffff;
        box-shadow: 0 0 0 3px rgba(26, 179, 148, 0.15);
    }

    /* Estilização dos Botões de Alternância de Pagamento (Tabs) */
    .btn-opcao-pagamento {
        border: 2px solid var(--borda-suave);
        background: #ffffff;
        padding: 15px;
        border-radius: 6px;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s ease;
        margin-bottom: 15px;
    }

    .btn-opcao-pagamento.active {
        border-color: var(--cor-primaria);
        background-color: #f0fdf4;
        color: var(--cor-primaria-hover);
    }

    .btn-opcao-pagamento i {
        font-size: 24px;
        margin-bottom: 8px;
        display: block;
    }

    /* Botão de Demonstração Superior */
    .btn-demo-superior {
        background-color: var(--cor-primaria);
        color: #ffffff !important;
        font-weight: 700;
        border-radius: 20px;
        padding: 8px 20px;
        border: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-demo-superior:hover {
        background-color: var(--cor-primaria-hover);
        transform: translateY(-1px);
    }

    .header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .row-compacto {
        margin-left: -10px;
        margin-right: -10px;
    }
    .row-compacto > [class*="col-"] {
        padding-left: 10px;
        padding-right: 10px;
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {
        .col-lg-3, .col-lg-4, .col-lg-6, .col-lg-12, .col-md-4, .col-xs-12 {
            width: 100% !important;
            float: none !important;
        }
    }
</style>

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                
                <div class="ibox-title header-flex" style="border-bottom: 1px solid var(--borda-suave); padding-bottom: 15px;">
                    <h2 style="font-weight: 800; color: var(--cor-azul-escuro); margin:0;">Finalizar Contratação - WebDoctorPro</h2>
                    <a href="@Url.Action("MontarTelaDemo", "BaseAdmin")" class="btn btn-demo-superior show-spinner">
                        <i class="fa fa-laptop-medical"></i> Solicite Demonstração Agora
                    </a>
                </div>
                
                <div class="ibox-content" style="background: transparent; border: none; padding: 20px 0;">
                    
                    <div class="card-moderno">
                        @using (Html.BeginForm("ProcessarPagamento", "BaseAdmin", FormMethod.Post, new { @id = "formCheckout" }))
                        {
                            <input type="hidden" name="nomeAssinante" value="@Model.Nome" />
                            <input type="hidden" name="emailAssinante" value="@Model.Resposta" />
                            <input type="hidden" name="nomePlano" value="@Model.Mensagem" />
                            <input type="hidden" name="valorTotal" value="@Model.Preco" />
                            
                            <input type="hidden" id="tipoPagamento" name="tipoPagamento" value="PIX" />

                            <div class="row">
                                <div class="col-lg-12">
                                    <h3 style="color: var(--cor-azul-base); font-weight: 700; margin-bottom: 20px;">Escolha a Forma de Pagamento</h3>
                                </div>
                                
                                <div class="col-sm-6 col-xs-12">
                                    <div class="btn-opcao-pagamento active" id="opcaoPix" onclick="selecionarMetodo('PIX')">
                                        <i class="fa fa-pix" style="color: #32bcad;"></i>
                                        <strong>Pagar com PIX</strong>
                                        <small class="display-block" style="color: #676a6c; font-weight: normal; margin-top:4px;">Liberação imediata do sistema</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-xs-12">
                                    <div class="btn-opcao-pagamento" id="opcaoCartao" onclick="selecionarMetodo('CREDIT_CARD')">
                                        <i class="fa fa-credit-card" style="color: var(--cor-azul-base);"></i>
                                        <strong>Cartão de Crédito</strong>
                                        <small class="display-block" style="color: #676a6c; font-weight: normal; margin-top:4px;">À vista ou parcelado em até 12x</small>
                                    </div>
                                </div>
                            </div>

                            <div id="secaoCartao" style="display: none; margin-top: 20px; border-top: 1px solid var(--borda-suave); padding-top: 20px;">
                                <h3 style="color: var(--cor-primaria); font-weight: 700; margin-bottom: 15px;">Dados do Cartão</h3>
                                
                                <div class="row-compacto">
                                    <div class="col-lg-6 col-md-6 col-xs-12">
                                        <label style="font-weight: 600;">Número do Cartão</label>
                                        <input type="text" id="numCartao" name="numCartao" class="form-control form-control-moderno" placeholder="0000 0000 0000 0000" />
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-xs-12">
                                        <label style="font-weight: 600;">Nome Impresso no Cartão</label>
                                        <input type="text" id="nomeCartao" name="nomeCartao" class="form-control form-control-moderno" placeholder="Ex: ALBERTO RINCON" />
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-xs-6">
                                        <label style="font-weight: 600;">Validade (Mês)</label>
                                        <input type="text" id="mesCartao" name="mesCartao" class="form-control form-control-moderno" placeholder="MM" maxLimit="2" />
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-xs-6">
                                        <label style="font-weight: 600;">Validade (Ano)</label>
                                        <input type="text" id="anoCartao" name="anoCartao" class="form-control form-control-moderno" placeholder="AAAA" maxLimit="4" />
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-xs-12">
                                        <label style="font-weight: 600;">CVC / CCV</label>
                                        <input type="text" id="cvcCartao" name="cvcCartao" class="form-control form-control-moderno" placeholder="123" />
                                    </div>
                                    
                                    <div class="col-lg-4 col-md-4 col-xs-12">
                                        <label style="font-weight: 600;">Opções de Parcelamento</label>
                                        <select id="parcelas" name="parcelas" class="form-control form-control-moderno">
                                            @if (precoTotal > 0)
                                            {
                                                for (int i = 1; i <= 12; i++)
                                                {
                                                    decimal valorDaParcela = precoTotal / i;
                                                    
                                                    // Critério de parada: Se o valor da parcela for menor que R$ 50,00, não renderiza as próximas
                                                    if (i > 1 && valorDaParcela < 50.00m)
                                                    {
                                                        break;
                                                    }
                                                    
                                                    <option value="@i">@(i)x de R$ @valorDaParcela.ToString("N2") (Sem juros)</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="1">1x de R$ 0,00</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 30px; border-top: 1px solid var(--borda-suave); padding-top: 20px;">
                                <div class="col-lg-12">
                                    <button type="submit" class="btn btn-primary" id="btnFinalizar" style="padding: 12px 24px; font-weight: 700; border-radius: 6px; width: 100%;">
                                        <i class="fa fa-lock"></i> Confirmar Pagamento com Segurança
                                    </button>
                                    <div id="loadingIndicator" style="display: none; text-align: center; margin-top: 15px; color: var(--cor-azul-base); font-weight: 600;">
                                        <i class="fa fa-spinner fa-spin fa-2x"></i> <br/>Processando transação com o banco. Por favor, não feche esta janela...
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/inputmask")
    
    <script type="text/javascript">
        function selecionarMetodo(metodo) {
            $("#tipoPagamento").val(metodo);

            if (metodo === 'PIX') {
                $("#opcaoPix").addClass("active");
                $("#opcaoCartao").removeClass("active");
                $("#secaoCartao").slideUp();
            } else {
                $("#opcaoCartao").addClass("active");
                $("#opcaoPix").removeClass("active");
                $("#secaoCartao").slideDown();
            }
        }

        $(document).ready(function () {
            $("#numCartao").mask("9999 9999 9999 9999");
            $("#mesCartao").mask("99");
            $("#anoCartao").mask("9999");
            $("#cvcCartao").mask("999");

            $("#formCheckout").on("submit", function () {
                $("#btnFinalizar").prop("disabled", true).addClass("disabled").html("<i class='fa fa-circle-notch fa-spin'></i> Comunicando...");
                $("#loadingIndicator").show();
                return true; 
            });
        });
    </script>
}