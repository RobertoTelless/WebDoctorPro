*@

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebDoctorPro | Prontuário Eletrônico e Automação de Consultórios</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        /* ==========================================================================
           RESET E VARIÁVEIS DE DESIGN (Paleta Baseada na Apresentação RTi)
           ========================================================================== */
        :root {
            --bg-primary: #0f172a;       /* Dark Blue/Noir de fundo */
            --bg-secondary: #1e293b;     /* Deep slate para cards e seções */
            --text-main: #f8fafc;        /* Branco off-white para legibilidade */
            --text-muted: #94a3b8;       /* Cinza para textos secundários */
            --accent-teal: #0ea5e9;      /* Azul Ciano/Teal Médico para CTAs */
            --accent-hover: #38bdf8;     /* Variação Hover ativa */
            --border-color: #334155;     /* Divisores sutis */
            --font-stack: 'Inter', sans-serif;
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-stack);
            background-color: var(--bg-primary);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ==========================================================================
           COMPONENTES REUTILIZÁVEIS / UTILITIES
           ========================================================================== */
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.95rem;
            text-decoration: none;
            transition: var(--transition-smooth);
            cursor: pointer;
            border: none;
            gap: 0.5rem;
        }

        .btn-primary {
            background-color: var(--accent-teal);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(14, 165, 233, 0.3);
        }

        .btn-primary:hover {
            background-color: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }

        .btn-outline:hover {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: var(--text-muted);
        }

        .section-padding {
            padding: 5rem 0;
        }

        .section-title {
            font-size: 2.25rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 3rem;
            letter-spacing: -0.025em;
        }

        .section-title span {
            color: var(--accent-teal);
        }

        /* ==========================================================================
           HEADER / NAVIGATION
           ========================================================================== */
        header {
            background-color: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border-color);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 4.5rem;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-main);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo i {
            color: var(--accent-teal);
        }

        .nav-menu {
            display: flex;
            gap: 1.5rem;
            align-items: center;
            list-style: none;
        }

        .nav-link {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            transition: var(--transition-smooth);
        }

        .nav-link:hover {
            color: var(--text-main);
        }

        /* ==========================================================================
           HERO SECTION
           ========================================================================== */
        .hero {
            padding-top: 9.5rem;
            padding-bottom: 6rem;
            position: relative;
            background: radial-gradient(circle at top right, rgba(14, 165, 233, 0.1), transparent 45%);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            align-items: center;
        }

        @@media (min-width: 992px) {
            .hero-grid {
                grid-template-columns: 1.2fr 0.8fr;
            }
        }

        .hero-content h1 {
            font-size: 3.5rem;
            line-height: 1.1;
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.03em;
        }

        .hero-content p {
            font-size: 1.25rem;
            color: var(--text-muted);
            margin-bottom: 2.5rem;
            max-width: 600px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .hero-image-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .hero-image-mockup {
            width: 100%;
            max-width: 450px;
            background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary));
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .mockup-header {
            display: flex;
            gap: 0.5rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.75rem;
        }

        .mockup-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: var(--border-color);
        }

        .mockup-body {
            height: 250px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            border-radius: 6px;
        }

        /* ==========================================================================
           APRESENTAÇÃO SLIDES (Dinâmico / Modular)
           ========================================================================== */
        .presentation-section {
            border-top: 1px solid var(--border-color);
        }

        .presentation-section:nth-child(even) {
            background-color: var(--bg-secondary);
        }

        .slide-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            align-items: center;
        }

        @@media (min-width: 768px) {
            .slide-grid {
                grid-template-columns: 1fr 1fr;
            }
            .slide-reverse {
                direction: rtl;
            }
            .slide-reverse > * {
                direction: ltr;
            }
        }

        .slide-content h2 {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-main);
        }

        .slide-content p {
            color: var(--text-muted);
            font-size: 1.05rem;
        }

        .slide-visual {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 3rem;
            text-align: center;
            font-size: 3.5rem;
            color: var(--accent-teal);
        }

        /* ==========================================================================
           FORMULÁRIO DE CONTATO (Imagem 1 & Imagem 2 Base Layout)
           ========================================================================== */
        .contact-section {
            background-color: var(--bg-secondary);
            border-top: 1px solid var(--border-color);
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        @@media (min-width: 992px) {
            .contact-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* Lado Esquerdo: Form */
        .form-wrapper {
            background-color: var(--bg-primary);
            padding: 2.5rem;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--text-main);
        }

        .form-control {
            width: 100%;
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 0.75rem 1rem;
            color: var(--text-main);
            font-family: var(--font-stack);
            font-size: 0.95rem;
            transition: var(--transition-smooth);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent-teal);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
        }

        .form-row-radio {
            display: flex;
            gap: 1.5rem;
            margin-top: 0.5rem;
        }

        .radio-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-size: 0.95rem;
        }

        .radio-label input {
            accent-color: var(--accent-teal);
            width: 16px;
            height: 16px;
        }

        .form-instructions {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-instructions p {
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 0.25rem;
        }

        .form-instructions span {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .form-instructions span::before {
            content: "•";
            color: var(--accent-teal);
            font-weight: bold;
        }

        /* Lado Direito: Mensagens Institucionais */
        .info-wrapper {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 2rem;
        }

        .info-card {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            background: rgba(255, 255, 255, 0.02);
            padding: 1.5rem;
            border-radius: 8px;
            border-left: 4px solid var(--accent-teal);
        }

        .info-card i {
            font-size: 1.5rem;
            color: var(--accent-teal);
            margin-top: 0.25rem;
        }

        .info-card p {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text-main);
        }

        /* ==========================================================================
           FOOTER (Imagem 3 & Imagem 4 Base Layout)
           ========================================================================== */
        footer {
            background-color: var(--bg-primary);
            border-top: 1px solid var(--border-color);
            padding: 4rem 0 2rem 0;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        @@media (min-width: 768px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        .footer-half-left {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-link {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 1rem;
            transition: var(--transition-smooth);
            width: fit-content;
        }

        .footer-link:hover {
            color: var(--accent-teal);
            padding-left: 4px;
        }

        .footer-half-right {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        @@media (min-width: 768px) {
            .footer-half-right {
                align-items: flex-end;
                text-align: right;
            }
        }

        .social-links {
            display: flex;
            gap: 1rem;
        }

        .social-btn {
            background-color: var(--bg-secondary);
            color: var(--text-main);
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: var(--transition-smooth);
            border: 1px solid var(--border-color);
        }

        .social-btn:hover {
            background-color: #25d366; /* Cor oficial WhatsApp */
            border-color: #25d366;
            transform: scale(1.1);
        }

        .copyright-box {
            border-top: 1px solid var(--border-color);
            padding-top: 2rem;
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.8;
        }

        .copyright-box strong {
            color: var(--text-main);
            display: block;
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        /* ==========================================================================
           RESPONSIVIDADE EXTRA MOBILES
           ========================================================================== */
        @@media (max-width: 767px) {
            .nav-menu {
                display: none; /* Menu simplificado para manter foco na conversão via CTAs corporativos */
            }
            .hero-content h1 {
                font-size: 2.5rem;
            }
            .section-title {
                font-size: 1.75rem;
            }
        }
    </style>
</head>
