                    </div>
                </div>
                <div class="hero-image-wrapper">
                    <div class="hero-image-mockup">
                        <div class="mockup-header">
                            <div class="mockup-dot"></div>
                            <div class="mockup-dot"></div>
                            <div class="mockup-dot"></div>
