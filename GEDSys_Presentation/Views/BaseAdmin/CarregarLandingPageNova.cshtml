                        <div class="info-card">
                            <i class="fa-solid fa-heart-pulse"></i>
                            <p>Ganhe tempo para o que mais interessa... Seus pacientes.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-half-left">
