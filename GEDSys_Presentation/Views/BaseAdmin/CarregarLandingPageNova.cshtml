                    <i class="fa-solid fa-credit-card"></i>
                </div>
            </div>
        </section>

        <section id="contato" class="contact-section section-padding">
            <div class="container">
                <h2 class="section-title">Fale Conosco — <span>Fácil e Rápido</span></h2>
                
                <div class="contact-grid">
                    <div class="form-wrapper">
                        <form id="contactForm" novalidate>
                            <div class="form-group">
                                <label for="nome">Nome Completo</label>
                                <input type="text" id="nome" class="form-control" placeholder="Digite seu nome" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="email">E-mail Corporativo</label>
                                <input type="email" id="email" class="form-control" placeholder="exemplo@empresa.com" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="celular">Celular</label>
                                <input type="text" id="celular" class="form-control" placeholder="(99) 99999-9999" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="motivo">Motivo do Contato</label>
                                <select id="motivo" class="form-control" required>
                                    <option value="" disabled selected>Selecione um motivo...</option>
