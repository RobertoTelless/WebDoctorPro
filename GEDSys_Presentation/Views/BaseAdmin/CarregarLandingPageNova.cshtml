    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Configurações padrão do Toastr
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "4000"
        };

        $(document).ready(function () {
            
            // Máscara Intuitiva para o campo Celular: (99)99999-9999
            const phoneInput = document.getElementById('celular');
            phoneInput.addEventListener('input', function (e) {
                let x = e.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,5})(\d{0,4})/);
                e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
            });

            // Validação e envio do Formulário de Contato via Ajax simulado
            $('#contactForm').on('submit', function (e) {
                e.preventDefault();

                // Captura dos valores
                const nome = $('#nome').val().trim();
                const email = $('#email').val().trim();
                const celular = $('#celular').val().trim();
                const motivo = $('#motivo').val();
                const respostaPref = $('input[name="respostaPref"]:checked').val();
                const mensagem = $('#mensagem').val().trim();

                // Regex de Validação
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                const celularRegex = /^\(\d{2}\)\s\d{5}-\d{4}$/;

                // Validações de consistência do Front-end
                if (!nome || !email || !celular || !motivo || !mensagem) {
                    toastr.error('Por favor, preencha todos os campos obrigatórios.');
                    return;
                }

                if (!emailRegex.test(email)) {
                    toastr.warning('Por favor, insira um e-mail com formato válido.');
                    return;
                }

                if (!celularRegex.test(celular)) {
                    toastr.warning('Por favor, insira o número de celular no formato correto: (99)99999-9999.');
                    return;
                }

                // Simulação de postagem segura e redirecionamento de intenção para e-mail corporativo
                Swal.fire({
                    title: 'Enviando Mensagem...',
                    text: 'Conectando ao servidor de correio da RTi Ltda.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                setTimeout(function () {
                    Swal.close();

                    // Dispara feedback de sucesso absoluto via SweetAlert2
                    Swal.fire({
                        icon: 'success',
                        title: 'Sucesso!',
                        text: 'Sua mensagem foi processada e direcionada para suporte@@rtiltda.net. Entraremos em contato em breve!',
                        confirmButtonColor: '#0ea5e9'
                    });

                    // Limpa o formulário após o envio bem-sucedido
                    $('#contactForm')[0].reset();

                }, 1500);
            });
        });
    </script>
</body>
</html>