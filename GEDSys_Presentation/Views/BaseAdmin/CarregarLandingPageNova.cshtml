                            <div class="form-group">
                                <label>Como deseja receber a resposta?</label>
                                <div class="form-row-radio">
                                    <label class="radio-label">
                                        <input type="radio" name="respostaPref" value="E-Mail" checked required> E-Mail
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="respostaPref" value="WhatsApp"> WhatsApp
                                    </label>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label for="mensagem">Como podemos ajudar? (Máx. 1000 caracteres)</label>
                                <textarea id="mensagem" class="form-control" rows="4" maxlength="1000" placeholder="Escreva sua mensagem aqui..." required></textarea>
                            </div>
                            
                            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
                                <i class="fa-solid fa-envelope"></i> Enviar Mensagem
                            </button>
