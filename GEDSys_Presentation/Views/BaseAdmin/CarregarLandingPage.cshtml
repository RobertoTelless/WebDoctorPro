        function EnviarFormularioContato(event) {
            event.preventDefault();

            var nome = $('#txtNome').val().trim();
            var email = $('#txtEmail').val().trim();
            var celular = $('#txtCelular').val().trim();
            var motivo = $('#txtMotivo').val().trim();
            var respostaPor = $('input[name="radResposta"]:checked').val();
            var mensagem = $('#txtMensagem').val().trim();

            if (celular.length < 14) {
                toastr.warning("Por favor, preencha o número de celular completo com o DDD.", "Formato Inválido");
                return false;
            }

            // Loader UI/UX do SweetAlert2 ativo durante a transmissão real
            Swal.fire({
                title: 'Processando Envio',
                text: 'Encaminhando sua mensagem para suporte@rtiltda.net...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Chamada AJAX real conectando com o Back-End do seu Controller
            // IMPORTANTE: Ajuste "Home" para o nome do seu Controller correspondente
            $.ajax({
                url: '@Url.Action("EnviarEmailContato", "BaseAdmin")', 
                type: 'POST',
                data: {
                    nome: nome,
                    email: email,
                    celular: celular,
                    motivo: motivo,
                    respostaPor: respostaPor,
                    mensagem: mensagem
                },
                success: function (response) {
                    Swal.close();

                    if (response.Sucesso) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Mensagem Enviada com Sucesso!',
                            html: 'Obrigado pelo contato, <strong>' + nome + '</strong>! Suas informações foram enviadas para o suporte técnico. Iremos responder o quanto antes via <strong>' + respostaPor + '</strong>.',
                            confirmButtonColor: '#1ab394'
                        });

                        toastr.success(response.Mensagem, "Suporte Notificado");
                        $('#formContatoWebDoctor')[0].reset(); // Limpa o formulário
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Falha no Envio',
                            text: response.Mensagem,
                            confirmButtonColor: '#1ab394'
                        });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro de Conexão',
