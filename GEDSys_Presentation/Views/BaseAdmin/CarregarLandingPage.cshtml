@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebDoctor | @ViewBag.Title</title>
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <!-- Add jQuery Style direct - used for jQGrid plugin -->
    <link href="@Url.Content("~/Scripts/plugins/jquery-ui/jquery-ui.min.css")" rel="stylesheet" type="text/css" />
    <link rel="shortcut icon" href="@Url.Content("~/Images/Prontuario/prontuario_icon_3.png?v=1.1")" type="image/png">
    <link href="~/Content/Custom.css" rel="stylesheet" />
    <!-- Primary Inspinia style -->
    @Styles.Render("~/Content/css")
    @Styles.Render("~/font-awesome/css")
    @Styles.Render("~/Content/Spinner_Style.css")
    <link href="~/Content/Custom.css" rel="stylesheet" />

    <style>
        /* ----------------------------------------------------------- */
        /* Padrões Globais, Variáveis de Design & Reset de UI         */
        /* ----------------------------------------------------------- */
        :root {
            --bg-principal: #eff2f6;
            --texto-base: #051a2c;
            --cor-primaria: #1ab394;
            --cor-primaria-hover: #18a689;
            --cor-azul-escuro: #0a2540;
            --cor-borda: #cbd5e1;
            --card-bg: #ffffff;
            --transicao: all 0.3s ease;
        }

        body {
            background-color: var(--bg-principal) !important;
            color: var(--texto-base) !important;
            font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Espaçamentos padronizados para evitar poluição visual */
        section {
            padding: 90px 0;
            position: relative;
        }

        .container-custom {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            box-sizing: border-box;
        }

        /* Utilitários de Flexbox Responsivo */
        .flex-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .col-half {
            flex: 1;
            min-width: 300px;
        }

        /* Transições de botões e links */
        .btn-custom {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 28px;
            font-weight: 600;
            border-radius: 6px;
            transition: var(--transicao);
            cursor: pointer;
            text-decoration: none !important;
            border: none;
        }

        .btn-primary-custom {
            background-color: var(--cor-primaria);
            color: #ffffff !important;
        }

        .btn-primary-custom:hover {
            background-color: var(--cor-primaria-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(26, 179, 148, 0.3);
        }

        /* ========================================== */
        /* OPÇÃO 1: VERSÃO EM TONS DE AZUL            */
        /* ========================================== */
        .btn-success-custom {
            background-color: #0a2540; /* Azul escuro corporativo */
            color: #ffffff !important;
        }

        .btn-success-custom:hover {
            background-color: #031424; /* Azul mais escuro no hover */
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(10, 37, 64, 0.3); /* Sombra azulada */
        }

        /* ========================================== */
        /* OPÇÃO 2: VERSÃO EM TONS DE VERMELHO        */
        /* ========================================== */
        .btn-danger-custom {
            background-color: #dc2626; /* Vermelho padrão médico/alerta */
            color: #ffffff !important;
        }

        .btn-danger-custom:hover {
            background-color: #b91c1c; /* Vermelho mais escuro no hover */
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3); /* Sombra avermelhada */
        }

        /* ----------------------------------------------------------- */
        /* Seção 1: Hero Section                                       */
        /* ----------------------------------------------------------- */
        .hero-section {
            background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
            border-bottom: 1px solid var(--cor-borda);
            padding: 60px 0 100px 0;
        }

        .hero-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 80px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .hero-logo h1 {
            font-size: 28px;
            font-weight: 800;
            color: var(--cor-azul-escuro);
            margin: 0;
            letter-spacing: -0.5px;
        }

        .hero-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .hero-links a {
            color: var(--texto-base);
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            transition: var(--transicao);
        }

        .hero-links a:hover {
            color: var(--cor-primaria);
        }

        .hero-links a.link-login-custom {
            color: var(--cor-primaria) !important;
            font-size: 20px !important; 
            font-weight: 800 !important;
        }

        .hero-links a.link-login-custom:hover {
            color: var(--cor-primaria-hover) !important;
        }

        .hero-content {
            align-items: center;
        }

        .hero-text h2 {
            font-size: 42px;
            font-weight: 800;
            line-height: 1.2;
            color: var(--cor-azul-escuro);
            margin-bottom: 15px;
        }

        .hero-text p {
            font-size: 18px;
            color: #475569;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .hero-image-wrapper {
            text-align: right;
        }

        .hero-img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            box-shadow: none;
        }

        .hero-img-full {
            width: 100%;
            max-width: 100%; /* Garante que ela se ajuste de forma responsiva */
            height: auto;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(5, 26, 44, 0.08); /* Sombra suave opcional */
            display: block;
        }

        .hero-img-large {
            width: 100%;          /* Obriga a imagem a ocupar toda a largura da meia tela */
            height: auto;         /* Calcula a altura proporcionalmente para NÃO cortar nada */
            max-height: 80vh;     /* Limita a altura máxima para não estourar a tela */
            object-fit: contain;  /* Garante que a imagem inteira caiba dentro do espaço disponível */
            display: block;
        }

        /* Se você quiser que o bloco pai (flex-grid) permita que ela quebre linha e ocupe o espaço todo */
        .col-full {
            flex: 0 0 100%;
            width: 100%;
        }

        /* ----------------------------------------------------------- */
        /* Seção 2: Funcionalidades (Grid Corporativo)                 */
        /* ----------------------------------------------------------- */
        .funcionalidades-section {
            background-color: var(--bg-principal);
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: var(--cor-azul-escuro);
            margin-bottom: 10px;
        }

        .funcionalidades-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .funcionalidade-card {
            background-color: var(--card-bg);
            border: 1px solid var(--cor-borda);
            border-radius: 8px;
            padding: 30px;
            transition: var(--transicao);
        }

        .funcionalidade-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(5, 26, 44, 0.05);
            border-color: var(--cor-primaria);
        }

        .funcionalidade-icon {
            font-size: 36px;
            color: var(--cor-primaria);
            margin-bottom: 20px;
        }

        .funcionalidade-card h3 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--cor-azul-escuro);
        }

        .funcionalidade-card p {
            font-size: 14px;
            color: #475569;
            line-height: 1.6;
            margin: 0;
        }

        /* ----------------------------------------------------------- */
        /* Seção 3: Primeira Seção (Destaque Adicional)               */
        /* ----------------------------------------------------------- */
        .primeira-secao {
            background-color: #ffffff;
            border-top: 1px solid var(--cor-borda);
            border-bottom: 1px solid var(--cor-borda);
        }

        .destaque-container {
            align-items: center;
        }

        .destaque-text h3 {
            font-size: 28px;
            font-weight: 700;
            color: var(--cor-azul-escuro);
            margin-bottom: 20px;
        }

        .destaque-text p {
            font-size: 16px;
            color: #475569;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        /* ----------------------------------------------------------- */
        /* Seção 4: Formulário e Painel de Mensagens                  */
        /* ----------------------------------------------------------- */
        .formulario-section {
            background-color: var(--bg-principal);
        }

        /* Quadro Superior Moderno de Atendimento */
        .quadro-suporte-header {
            background: linear-gradient(135deg, var(--cor-azul-escuro) 0%, #111827 100%);
            border-left: 5px solid var(--cor-primaria);
            border-radius: 8px;
            padding: 25px 30px;
            margin-bottom: 35px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 4px 15px rgba(5, 26, 44, 0.08);
        }

        .quadro-suporte-icon {
            font-size: 32px;
            color: var(--cor-primaria);
            background-color: rgba(26, 179, 148, 0.12);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .quadro-suporte-text h4 {
            color: #ffffff;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 4px 0;
        }

        .quadro-suporte-text p {
            color: #94a3b8;
            font-size: 14px;
            margin: 0;
            font-weight: 500;
        }

        .form-card {
            background-color: var(--card-bg);
            padding: 40px;
            border-radius: 8px;
            border: 1px solid var(--cor-borda);
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .form-group-custom {
            margin-bottom: 20px;
        }

        .form-group-custom label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--texto-base);
        }

        .form-control-custom {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--cor-borda);
            border-radius: 6px;
            background-color: #f8fafc;
            color: var(--texto-base);
            font-size: 14px;
            transition: var(--transicao);
            box-sizing: border-box;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--cor-primaria);
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(26, 179, 148, 0.15);
        }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 5px;
        }

        .radio-option {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
        }

        .radio-option input {
            cursor: pointer;
            accent-color: var(--cor-primaria);
        }

        .instrucoes-container {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px dashed var(--cor-borda);
        }

        .instrucoes-container p {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .instrucoes-container ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .instrucoes-container li {
            font-size: 13px;
            color: #475569;
            margin-bottom: 8px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .instrucoes-container li i {
            color: var(--cor-primaria);
            margin-top: 3px;
        }

        /* Moldura Estilizada de Mensagens UX */
        .moldura-mensagens {
            border: 2px solid var(--cor-primaria);
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-shadow: 0 15px 30px rgba(26, 179, 148, 0.05);
            box-sizing: border-box;
        }

        .mensagem-item {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 35px;
        }

        .mensagem-item:last-child {
            margin-bottom: 0;
        }

        .mensagem-icon-box {
            width: 50px;
            height: 50px;
            background-color: rgba(26, 179, 148, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--cor-primaria);
            flex-shrink: 0;
        }

        .mensagem-item h4 {
            font-size: 18px;
            font-weight: 700;
            color: var(--cor-azul-escuro);
            margin: 0 0 4px 0;
        }

        /* ----------------------------------------------------------- */
        /* Seção 5: Footer                                             */
        /* ----------------------------------------------------------- */
        .footer-custom {
            background-color: var(--cor-azul-escuro);
            color: #94a3b8;
            padding: 60px 0 30px 0;
            border-top: 4px solid var(--cor-primaria);
        }

        .footer-top {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            padding-bottom: 40px;
            border-bottom: 1px solid #1e293b;
        }

        .footer-half {
            flex: 1;
            min-width: 280px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .footer-links a {
            color: #cbd5e1;
            text-decoration: none;
            font-weight: 500;
            transition: var(--transicao);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .footer-links a:hover {
            color: var(--cor-primaria);
            padding-left: 5px;
        }

        .social-title {
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .btn-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background-color: #25d366;
            color: #ffffff !important;
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 700;
            text-decoration: none;
            transition: var(--transicao);
        }

        .btn-whatsapp:hover {
            background-color: #20ba5a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(37, 211, 102, 0.3);
        }

        .copyright-box {
            margin-top: 30px;
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        .copyright-title {
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 5px;
            font-size: 15px;
        }

        /* Responsividade via Media Queries */
        @@media (max-width: 768px) {
            .flex-grid { flex-direction: column; }
            .hero-nav { flex-direction: column; text-align: center; }
            .hero-links { flex-direction: column; gap: 15px; margin-bottom: 20px; }
            .hero-text h2 { font-size: 32px; }
            .section-header h2 { font-size: 26px; }
            .form-card, .moldura-mensagens { padding: 25px; }
            .quadro-suporte-header { flex-direction: column; text-align: center; }
        }
    </style>
</head>
<body>

    <main>
        <section class="hero-section">
            <div class="container-custom">
                <nav class="hero-nav">
                    <div class="hero-logo">
                        <h1>WebDoctorPro</h1>
                    </div>
                    <div class="hero-links">
                        <a href="#funcionalidades"><i class="fa fa-list-check"></i> Funcionalidades</a>
                        <a href="@Url.Action("MontarTelaPrecos", "BaseAdmin")" target="_blank"><i class="fa fa-tags"></i> Planos e Preços</a>
                        <a href="#formulario"><i class="fa fa-envelope"></i> Fale Conosco</a>
                        @*<a href="@Url.Action("Login", "ControleAcesso")" target="_blank" style="color: var(--cor-primaria);"><i class="fa fa-right-to-bracket"></i> Login</a>*@
                        <a href="@Url.Action("Login", "ControleAcesso")" target="_blank" class="link-login-custom"><i class="fa fa-right-to-bracket"></i> Login</a>
                        <a href="@Url.Action("MontarTelaDemo", "BaseAdmin")" target="_blank" class="btn-custom btn-primary-custom" style="padding: 8px 16px;">Solicite Demonstração Agora</a>
                    </div>
                </nav>

                <div class="flex-grid hero-content">
                    <div class="col-half hero-text">
                        <h2>Prontuário Eletrônico e Automação de Consultórios</h2>
                        <p>A solução definitiva para médicos e clínicas que buscam centralizar prontuários, automatizar fluxos de atendimento e elevar a experiência de cuidado aos pacientes a um novo patamar de segurança e eficiência.</p>
                        <a href="@Url.Action("MontarTelaAreaPaciente", "AreaPaciente")" target="_blank" class="btn-custom btn-success-custom">Área do Paciente<i class="fa fa-arrow-right" style="margin-left:8px;"></i></a>
                        <a href="@Url.Action("MontarTelaValidacaoDocumento", "ValidacaoDocumento")" target="_blank" class="btn-custom btn-danger-custom">Validação de Documentos<i class="fa fa-arrow-right" style="margin-left:8px;"></i></a>
                    </div>
                    <div class="col-half hero-image-wrapper">
                        <img src="/Images/Imagens_Site/HeroSection.png" class="hero-img hero-img-large" alt="Prontuário Eletrônico WebDoctorPro" />
                    </div>
                    @*<div class="col-half hero-image-wrapper">
                        <img src="/Images/Imagens_Site/HeroSection.png" class="hero-img" alt="Prontuário Eletrônico WebDoctorPro" />
                    </div>*@
                </div>
            </div>
        </section>

        <section id="funcionalidades" class="funcionalidades-section">
            <div class="container-custom">
                <div class="section-header">
                    <h2>Funcionalidades Avançadas</h2>
                    <p>Tudo o que o seu consultório precisa integrado em um ecossistema seguro.</p>
                </div>
                <div class="funcionalidades-grid">
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-folder-open"></i></div>
                        <h3>Prontuário Eletrônico</h3>
                        <p>Histórico clínico digital completo, anamnese personalizada e acesso rápido aos dados de evolução do paciente.</p>
                    </div>
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-calendar-check"></i></div>
                        <h3>Agenda Inteligente</h3>
                        <p>Controle total de horários, marcações rápidas, status de atendimento e confirmações em tempo real.</p>
                    </div>
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-bell"></i></div>
                        <h3>Alertas e Avisos</h3>
                        <p>Lembretes automáticos para profissionais e pacientes, reduzindo faltas e organizando a fila de espera.</p>
                    </div>
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-chart-line"></i></div>
                        <h3>Gestão de Processos</h3>
                        <p>Acompanhamento analítico das etapas de atendimento do paciente desde o primeiro contato até o pós-consulta.</p>
                    </div>
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-file-pdf"></i></div>
                        <h3>Prescrições e Relatórios</h3>
                        <p>Emissão ágil de receitas, atestados e relatórios clínicos profissionais diretamente pelo sistema.</p>
                    </div>
                    <div class="funcionalidade-card">
                        <div class="funcionalidade-icon"><i class="fa fa-shield-halved"></i></div>
                        <h3>Segurança Total (LGPD)</h3>
                        <p>Criptografia avançada de ponta a ponta e total conformidade com a Lei Geral de Proteção de Dados.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="primeira-secao">
            <div class="container-custom">
                <div class="flex-grid destaque-container">
                    <div class="col-half">
                        <div class="col-half hero-image-wrapper">
                            <img src="/Images/Imagens_Site/Seção 1.png" class="hero-img" alt="Prontuário Eletrônico WebDoctorPro" />
                        </div>
                    </div>
                    <div class="col-half destaque-text">
                        <h3>Tecnologia Desenvolvida para a Prática Médica</h3>
                        <p>O WebDoctorPro foi desenhado por especialistas técnicos em conjunto com profissionais de saúde. O resultado é um fluxo de telas intuitivo e veloz, eliminando a burocracia mecânica e cliques desnecessários do seu dia a dia.</p>
                        <p>Gerencie múltiplas unidades ou consultórios sob o mesmo guarda-chuva corporativo com total integridade de dados na nuvem.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="segunda-secao">
            <div class="container-custom">
                <div class="flex-grid destaque-container">
                    <div class="col-half destaque-text">
                        <h3>A Fundação: Segurança de Nível Hospitalar</h3>
                        <p>A proteção de dados sensíveis é o alicerce fundamental de todas as operações, garantindo um ambiente com acesso restrito, rastreável e criptografado de ponta a ponta.</p>
                        <ul style="list-style-type: disc; padding-left: 20px; margin-top: 15px; color: #475569; line-height: 1.7;">
                            <li style="margin-bottom: 8px;"><strong>Acesso Controlado:</strong> Oferece proteção rigorosa por meio do uso de senhas individuais para cada usuário.</li>
                            <li style="margin-bottom: 8px;"><strong>Criptografia Avançada:</strong> Garante a proteção total da base de dados, blindando as informações contra acessos não autorizados.</li>
                            <li style="margin-bottom: 0;"><strong>Autenticidade Garantida:</strong> Conta com suporte nativo integrado para o uso de assinatura digital em todos os documentos emitidos.</li>
                        </ul>                    
                    </div>
                    <div class="col-half">
                        <div class="col-half hero-image-wrapper">
                            <img src="/Images/Imagens_Site/Seção 2.png" class="hero-img" alt="Prontuário Eletrônico WebDoctorPro" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="terceira-secao">
            <div class="container-custom">
                <div class="flex-grid destaque-container">
                    <div class="col-half">
                        <div class="col-half hero-image-wrapper">
                            <img src="/Images/Imagens_Site/Seção 3.png" class="hero-img" alt="Prontuário Eletrônico WebDoctorPro" />
                        </div>
                    </div>
                    <div class="col-half destaque-text">
